<link rel="stylesheet" href="~/css/home/chatbot.css" />
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

@* Preview bubble — tự hiện sau 3 giây, tự mất sau 5 giây *@
<div class="chatbot-preview-bubble" id="preview-bubble">
    <button class="bubble-close" onclick="dismissBubble()" title="Đóng">×</button>
    <div class="bubble-name">🤖 Trợ lý AI SuperStar</div>
    Xin chào! Tôi có thể giúp bạn đặt lịch khám hoặc tư vấn sức khỏe.
</div>

@* Toggle button với pulse + online dot *@
<button class="chatbot-toggler" onclick="toggleChatbot()" title="Trợ lý AI">
    <span class="online-dot"></span>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z" />
        <circle cx="9" cy="14" r="1.2" fill="#fff" stroke="none" />
        <circle cx="15" cy="14" r="1.2" fill="#fff" stroke="none" />
    </svg>
</button>

@* Chatbot window — giữ nguyên toàn bộ HTML gốc *@
<div class="chatbot-window" id="chatbot-window">
    <div class="chatbot-header">
        <div class="chatbot-header-avatar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z" />
                <circle cx="9" cy="14" r="1.2" fill="#fff" stroke="none" />
                <circle cx="15" cy="14" r="1.2" fill="#fff" stroke="none" />
            </svg>
        </div>
        <div class="chatbot-header-info">
            <p class="name">Trợ lý AI Y Tế</p>
            <p class="status"><span class="status-dot"></span> Đang hoạt động</p>
        </div>
        <button class="btn-header-action" onclick="clearChatHistory()" title="Bắt đầu đoạn chat mới">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                <path d="M3 3v5h5" />
            </svg>
        </button>
        <button class="btn-header-action" onclick="toggleFullscreen()" id="btn-fullscreen" title="Phóng to">
            <svg id="icon-maximize" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9" />
                <polyline points="9 21 3 21 3 15" />
                <line x1="21" y1="3" x2="14" y2="10" />
                <line x1="3" y1="21" x2="10" y2="14" />
            </svg>
            <svg id="icon-minimize" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                <polyline points="4 14 10 14 10 20" />
                <polyline points="20 10 14 10 14 4" />
                <line x1="10" y1="14" x2="3" y2="21" />
                <line x1="21" y1="3" x2="14" y2="10" />
            </svg>
        </button>
        <button class="btn-header-action" onclick="document.body.classList.remove('show-chatbot')" title="Đóng">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>
    </div>

    <div class="chatbot-body" id="chatbot-body">
        <div class="msg-ai">
            <div class="msg-ai-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z" />
                    <circle cx="9" cy="14" r="1.2" fill="#fff" stroke="none" />
                    <circle cx="15" cy="14" r="1.2" fill="#fff" stroke="none" />
                </svg>
            </div>
            <div>
                <div class="msg-ai-bubble">
                    Xin chào! Tôi là trợ lý AI của <strong>Phòng Khám SuperStar</strong>. Bạn cần hỗ trợ gì ạ?
                </div>
                <div class="suggest-chips">
                    <span class="suggest-chip" onclick="sendSuggest('Đặt lịch khám')">Đặt lịch khám</span>
                    <span class="suggest-chip" onclick="sendSuggest('Hỏi triệu chứng')">Hỏi triệu chứng</span>
                    <span class="suggest-chip" onclick="sendSuggest('Tra cứu bác sĩ')">Tra cứu bác sĩ</span>
                </div>
            </div>
        </div>
    </div>

    <div class="chatbot-footer">
        <input type="text" id="chatbot-input" placeholder="Nhập câu hỏi của bạn..." onkeydown="if(event.key==='Enter') sendMessage()" />
        <button class="btn-send" id="chatbot-send-btn" onclick="sendMessage()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
        </button>
    </div>
</div>

<script>
    const chatBody   = document.getElementById('chatbot-body');
    const chatInput  = document.getElementById('chatbot-input');
    const chatWindow = document.getElementById('chatbot-window');
    const btnSend    = document.getElementById('chatbot-send-btn');
    let isAITyping   = false;

    const robotIconSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>
        <circle cx="9" cy="14" r="1.2" fill="#fff" stroke="none"/>
        <circle cx="15" cy="14" r="1.2" fill="#fff" stroke="none"/>
    </svg>`;

    let bubbleDismissed = false; // Cờ đánh dấu: Khách chê, không thèm nhìn

        function showPreviewBubble() {
            // Nếu khách đã tự tay bấm X, hoặc khung chat đang mở -> Tuyệt đối không làm phiền
            if (bubbleDismissed || document.body.classList.contains('show-chatbot')) return;

            const bubble = document.getElementById('preview-bubble');
            bubble.classList.add('visible');

            // Tự động mờ đi sau 5 giây (Nhưng KHÔNG khóa vĩnh viễn)
            setTimeout(() => {
                if (bubble.classList.contains('visible')) {
                    bubble.classList.remove('visible');
                }
            }, 5000); // 5000ms = 5 giây
        }

        function dismissBubble() {
            bubbleDismissed = true; // Khóa vĩnh viễn không bao giờ hiện lại
            document.getElementById('preview-bubble').classList.remove('visible');
        }
        setTimeout(showPreviewBubble, 5000);

        setInterval(showPreviewBubble, 20000);

    // ── Toggle chatbot: ẩn bubble khi mở chat ──
    function toggleChatbot() {
        document.body.classList.toggle('show-chatbot');
        // Ẩn bubble khi người dùng click nút
        dismissBubble();
    }

    function toggleFullscreen() {
        const isNowFullscreen = chatWindow.classList.toggle('is-fullscreen');
        document.getElementById('icon-maximize').style.display = isNowFullscreen ? 'none' : 'block';
        document.getElementById('icon-minimize').style.display = isNowFullscreen ? 'block' : 'none';
        document.getElementById('btn-fullscreen').title = isNowFullscreen ? 'Thu nhỏ' : 'Phóng to';
        setTimeout(() => { chatBody.scrollTop = chatBody.scrollHeight; }, 350);
    }

    function toggleLockUI(isLocked) {
        isAITyping = isLocked;
        chatInput.disabled = isLocked;
        btnSend.disabled   = isLocked;
        chatInput.style.opacity = isLocked ? '0.6' : '1';
        document.querySelectorAll('.suggest-chip').forEach(chip => {
            chip.style.opacity       = isLocked ? '0.5' : '1';
            chip.style.pointerEvents = isLocked ? 'none' : 'auto';
        });
        if (!isLocked) chatInput.focus();
    }

    function appendMsg(text, isUser) {
        const msgDiv = document.createElement('div');
        msgDiv.className = isUser ? 'msg-user' : 'msg-ai';
        if (isUser) {
            msgDiv.innerHTML = `<div class="msg-user-bubble"></div>`;
            msgDiv.querySelector('.msg-user-bubble').textContent = text;
        } else {
            let htmlText = typeof marked !== 'undefined' ? marked.parse(text) : text;
            let finalText = htmlText.replace(/\[BOOKING:(\d+)\|([^\|\]]+)(?:\|([^\]]+))?\]/g, function(match, doctorId, doctorName, doctorImg) {
                const defaultAvatar = 'https://cdn-icons-png.flaticon.com/512/3774/3774299.png';
                let imgSrc = doctorImg ? doctorImg.trim() : '';
                if (!imgSrc || imgSrc === 'null') { imgSrc = defaultAvatar; }
                else { imgSrc = '/img/doctors/' + imgSrc.split('/').pop(); }
                let cleanName = doctorName.replace(/(BS\.?|Bác sĩ)\s*/gi, '').trim();
                return `<div class="doctor-suggestion-card mt-2 mb-2" style="background:#fff;border-radius:10px;border:1px solid #dee2e6;display:flex;align-items:center;gap:10px;padding:10px;box-shadow:0 2px 4px rgba(0,0,0,.05);">
                    <img src="${imgSrc}" onerror="this.onerror=null;this.src='${defaultAvatar}';" alt="${cleanName}" style="width:45px;height:45px;border-radius:50%;object-fit:cover;border:1px solid #3B5BDB;">
                    <div style="flex:1;"><div style="font-size:13px;font-weight:bold;color:#333;">BS. ${cleanName}</div>
                    <a href="/Home/DoctorInfo/${doctorId}" style="font-size:11px;color:#3B5BDB;text-decoration:none;font-weight:600;"><i class="fas fa-calendar-alt"></i> Xem lịch & Đặt ngay</a></div></div>`;
            });
            msgDiv.innerHTML = `<div class="msg-ai-icon">${robotIconSvg}</div><div class="msg-ai-bubble" style="width:100%;">${finalText}</div>`;
        }
        chatBody.appendChild(msgDiv);
        chatBody.scrollTop = chatBody.scrollHeight;
    }

    function showTyping() {
        const div = document.createElement('div');
        div.className = 'msg-ai typing-container';
        div.innerHTML = `<div class="msg-ai-icon">${robotIconSvg}</div>
            <div class="typing-indicator">
                <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
            </div>`;
        chatBody.appendChild(div);
        chatBody.scrollTop = chatBody.scrollHeight;
        return div;
    }

    function sendMessage() {
        if (isAITyping) return;
        const text = chatInput.value.trim();
        if (!text) return;
        chatInput.value = '';
        appendMsg(text, true);
        const typingEl = showTyping();
        toggleLockUI(true);
        $.ajax({
            url: '/Chat/AskAI', type: 'POST', data: { message: text },
            success: function(response) {
                typingEl.remove();
                appendMsg(response.data || response, false);
            },
            error: function(xhr) {
                typingEl.remove();
                console.error("Chi tiết lỗi:", xhr.responseText);
                appendMsg("Mất kết nối với máy chủ AI rồi sếp ơi! Kiểm tra Console để xem chi tiết.", false);
            },
            complete: function() { toggleLockUI(false); }
        });
    }

    function sendSuggest(text) {
        if (isAITyping) return;
        chatInput.value = text;
        sendMessage();
    }

    function clearChatHistory() {
        $.ajax({
            url: '/Chat/ResetChat', type: 'POST',
            success: function(response) {
                if (response.success) {
                    chatBody.innerHTML = '';
                    appendMsg("Trí nhớ của tôi đã được dọn dẹp! Chào mừng bạn đến với ca tư vấn mới. Bạn cần hỗ trợ gì ạ?", false);
                }
            }
        });
    }
</script>
