@using PBL3_HealthCare.Models
@model IEnumerable<PBL3_HealthCare.Models.Appointment>

@{
    bool isDoctor = User.IsInRole("Doctor");
    ViewData["Title"] = isDoctor ? "Lịch khám của tôi" : "Quản lý Lịch khám";

    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (isDoctor)
    {
        Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(28,200,138,.15);">
            <i class="fas fa-check-circle mr-2"></i> <strong>Thành công!</strong> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(231,74,59,.15);">
            <i class="fas fa-exclamation-triangle mr-2"></i> <strong>Lỗi!</strong> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/appointments.css" />
}

<style>
    /* Giữ nguyên toàn bộ CSS của sếp */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

        .page-header h4 {
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        .page-header p {
            color: #9fa5b5;
            font-size: .85rem;
            margin: .25rem 0 0;
        }

    .btn-add {
        background: linear-gradient(135deg,#1cc88a,#13855c);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .6rem 1.4rem;
        font-weight: 600;
        font-size: .88rem;
        box-shadow: 0 4px 12px rgba(28,200,138,.3);
        transition: transform .15s;
    }

        .btn-add:hover {
            transform: translateY(-1px);
            color: #fff;
            box-shadow: 0 6px 18px rgba(28,200,138,.4);
        }

    .data-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(28,200,138,.08);
        overflow: hidden;
    }

        .data-card .card-body {
            padding: 0;
        }

    table.dataTable thead th {
        background: #f8fefc;
        color: #5a5c69;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .8px;
        font-weight: 700;
        border-bottom: 2px solid #e0faf3 !important;
        border-top: none !important;
        padding: 1rem 1.25rem !important;
    }

    table.dataTable tbody td {
        padding: .85rem 1.25rem !important;
        vertical-align: middle;
        font-size: .88rem;
        color: #2d3748;
        border-bottom: 1px solid #f0f2fa !important;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: .3rem .75rem;
        border-radius: 15px;
        font-size: .75rem;
        font-weight: 700;
    }

    .status-pending {
        background: #fff8e1;
        color: #856404;
        border: 1.5px solid #ffe082;
    }

    .status-confirmed {
        background: #e8fdf5;
        color: #0a5f38;
        border: 1.5px solid #a3e9c6;
    }

    .status-cancelled {
        background: #fde8e6;
        color: #842029;
        border: 1.5px solid #f5c2c7;
    }

    .date-text {
        font-weight: 600;
        color: #2d3748;
    }

    .timeslot-text {
        color: #36b9cc;
        font-weight: 600;
        font-size: .82rem;
    }

    .btn-action {
        border-radius: 8px;
        padding: .3rem .7rem;
        font-size: .78rem;
        font-weight: 600;
        border: none;
        transition: transform .1s;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }

    .btn-action-examine {
        background: #1cc88a;
        color: #fff;
    }
</style>

<div class="page-header">
    <div>
        <h4><i class="fas fa-calendar-check mr-2 text-success"></i>@(isDoctor ? "Lịch khám của tôi" : "Quản lý Lịch khám")</h4>
        <p>@(isDoctor ? "Theo dõi các ca khám bệnh được phân công cho bạn" : "Danh sách toàn bộ lịch hẹn khám trong hệ thống")</p>
    </div>
    @if (!isDoctor)
    {
        <a asp-action="Create" class="btn btn-add"><i class="fas fa-plus"></i> Tạo lịch khám</a>
    }
</div>

@* 🔥 KHU VỰC FIX LỖI KẸT TEMPDATA 🔥 *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(28,200,138,.15);">
        <i class="fas fa-check-circle mr-2"></i> <strong>Thành công!</strong> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(231,74,59,.15);">
        <i class="fas fa-exclamation-triangle mr-2"></i> <strong>Lỗi!</strong> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="data-card card mb-4">
    <div class="card-body">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Bệnh nhân</th>
                    @if (!isDoctor)
                    {
                        <th>Bác sĩ</th>
                    }
                    <th>Ngày khám</th>
                    <th>Khung giờ</th>
                    <th>Trạng thái</th>
                    <th>Lý do khám</th>
                    <th class="text-center" style="width:130px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="font-weight-bold">@(item.Patient?.FullName ?? item.PatientId)</span><br />
                            @if (item.IsVideoCall)
                            {
                                <span class="badge badge-info mt-1"><i class="fas fa-video"></i> Online</span>
                            }
                        </td>
                        @if (!isDoctor)
                        {
                            <td>BS. @(item.Doctor?.User?.FullName ?? "Bác sĩ")</td>
                        }
                        <td><span class="date-text">@item.Date.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="timeslot-text"><i class="fas fa-clock mr-1"></i>@Html.DisplayFor(m => item.TimeSlot)</span></td>
                        <td>
                            @{
                                bool isSvc = item.Reason.Contains("Gói Khám") || item.Reason.Contains("Tại Nhà") || item.Reason.Contains("Tiêm Chủng");
                            }

                            @if (item.Status == AppointmentStatus.Pending)
                            {
                                <span class="status-badge status-pending"><i class="fas fa-hourglass-half mr-1"></i> Chờ duyệt</span>
                            }
                            else if (item.Status == AppointmentStatus.Cancelled)
                            {
                                <span class="status-badge status-cancelled"><i class="fas fa-times-circle mr-1"></i> Đã hủy</span>
                            }
                            else if (item.MedicalRecord == null)
                            {
                                <span class="status-badge status-confirmed"><i class="fas fa-check-circle mr-1"></i> Xác nhận</span>
                            }
                            @* 🔥 BỔ SUNG: Dịch vụ xong bệnh án = Hoàn tất *@
                            else if (isSvc || (item.MedicalRecord.Prescriptions != null && item.MedicalRecord.Prescriptions.Any()))
                            {
                                <span class="status-badge" style="background:#e8edff; color:#4e73df; border: 1.5px solid #b8caff;">
                                    <i class="fas fa-clipboard-check mr-1"></i> Đã hoàn tất
                                </span>
                            }
                            else
                            {
                                <span class="status-badge" style="background:#fff3cd; color:#856404; border: 1.5px solid #ffeeba;">
                                    <i class="fas fa-notes-medical mr-1"></i> Chờ kê thuốc
                                </span>
                            }
                        </td>
                        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@item.Reason">
                            @(string.IsNullOrEmpty(item.Reason) ? "---" : item.Reason)
                        </td>
                        <td class="text-center">
                            @* Nút Duyệt/Hủy - Chỉ Admin thấy *@
                            @if (item.Status == AppointmentStatus.Pending)
                            {
                                <form asp-action="UpdateStatus" method="post" style="display: inline-block;">
                                    <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="newStatus" value="Confirmed" />
                                    <button type="submit" class="btn-action" style="background: #e8fdf5; color: #0a5f38; border: 1px solid #a3e9c6;"><i class="fas fa-check"></i></button>
                                </form>
                                <form asp-action="UpdateStatus" method="post" style="display: inline-block;">
                                    <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="newStatus" value="Cancelled" />
                                    <button type="submit" class="btn-action" style="background: #fde8e6; color: #842029; border: 1px solid #f5c2c7;"><i class="fas fa-times"></i></button>
                                </form>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-detail"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete"><i class="fas fa-trash"></i></a>
                            }
                            else if (isDoctor)
                            {
                                bool isSvcDoc = item.Reason.Contains("[Gói Khám]") || item.Reason.Contains("[Tại Nhà]") || item.Reason.Contains("[Tiêm Chủng]");

                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-detail" title="Chi tiết lịch khám"><i class="fas fa-info-circle"></i></a>

                                if (item.Status == AppointmentStatus.Confirmed)
                                {
                                    if (item.MedicalRecord == null)
                                    {
                                        if (item.IsVideoCall)
                                        {
                                            <span class="badge badge-info ms-1"><i class="fas fa-laptop-medical"></i> Chờ khám Online</span>
                                        }
                                        else
                                        {
                                            <a asp-controller="MedicalRecords" asp-action="Create" asp-route-appointmentId="@item.Id" class="btn-action btn-action-examine ms-1" title="Ghi bệnh án">
                                                <i class="fas fa-stethoscope mr-1"></i> Ghi bệnh án
                                            </a>
                                        }
                                    }
                                    @* 🔥 BỔ SUNG: Dịch vụ thì hiện nút Bệnh án, Khám thường thì hiện Kê thuốc *@
                                    else if (isSvcDoc || (item.MedicalRecord.Prescriptions != null && item.MedicalRecord.Prescriptions.Any()))
                                    {
                                        <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@item.MedicalRecord.Id"
                                           class="btn-action ms-1" style="background: #858796; color: #fff;" title="Xem Bệnh án">
                                            <i class="fas fa-file-medical mr-1"></i> Bệnh án
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Prescriptions" asp-action="Create" asp-route-medicalRecordId="@item.MedicalRecord.Id"
                                           class="btn-action ms-1" style="background: #f6c23e; color: #fff;" title="Kê thuốc">
                                            <i class="fas fa-pills mr-1"></i> Kê thuốc
                                        </a>
                                    }
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center"ip>',
                "order": [[ 2, "desc" ]]
            });
        });
    </script>
}