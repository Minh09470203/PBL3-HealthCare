@model PBL3_HealthCare.Models.Appointment

@{
    ViewData["Title"] = "Tạo Lịch khám mới";
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (User.IsInRole("Doctor"))
    {
        Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/appointments.css" />
}

<a asp-action="Index" class="btn btn-light btn-sm mb-3" style="border-radius:8px;">
    <i class="fas fa-arrow-left mr-1"></i>Quay lại
</a>

<div class="form-card create card mb-4">
    <div class="card-header">
        <h5><i class="fas fa-calendar-plus mr-2"></i>Tạo Lịch khám mới</h5>
        <p>Điền thông tin để đăng ký lịch khám cho bệnh nhân</p>
    </div>
    <div class="card-body">
        <form asp-action="Create" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="border-radius:10px;font-size:.85rem;"></div>

            <p class="form-section-title green">
                <i class="fas fa-users mr-1"></i>Thông tin liên quan
            </p>

            <div class="row">
                <!-- Patient -->
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label><i class="fas fa-procedures mr-1 text-muted"></i>Bệnh nhân</label>
                        <select asp-for="PatientId" class="form-control" asp-items="ViewBag.PatientId">
                            <option value="">-- Chọn bệnh nhân --</option>
                        </select>
                    </div>
                </div>

                <!-- Doctor -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-6">
                        <div class="form-floating-custom">
                            <label><i class="fas fa-user-md mr-1 text-muted"></i>Bác sĩ phụ trách</label>
                            <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId">
                                <option value="">-- Chọn bác sĩ --</option>
                            </select>
                        </div>
                    </div>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <!-- Doctor không được chọn, nhưng vẫn submit -->
                    <input type="hidden" asp-for="DoctorId" />
                }
            </div>

            <p class="form-section-title green">
                <i class="fas fa-clock mr-1"></i>Thời gian & Trạng thái
            </p>

            <div class="row">
                <!-- Date -->
                <div class="col-md-4">
                    <div class="form-floating-custom">
                        <label>Ngày khám</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-calendar"></i>
                            <input asp-for="Date" class="form-control" type="date" />
                        </div>
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </div>

                <!-- TimeSlot -->
                <div class="col-md-4">
                    <div class="form-floating-custom">
                        <label>Khung giờ</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-hourglass-half"></i>
                            <input asp-for="TimeSlot" class="form-control" placeholder="VD: 08:00 - 08:30" />
                        </div>
                        <span asp-validation-for="TimeSlot" class="text-danger"></span>
                    </div>
                </div>

                <!-- Status -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-4">
                        <div class="form-floating-custom">
                            <label>Trạng thái</label>
                            <select asp-for="Status" class="form-control">
                                <option value="Pending">Chờ duyệt</option>
                                <option value="Confirmed">Đã xác nhận</option>
                                <option value="Cancelled">Đã hủy</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <!-- Doctor không chọn status -->
                    <input type="hidden" asp-for="Status" />
                }
            </div>

            <p class="form-section-title green">
                <i class="fas fa-notes-medical mr-1"></i>Thông tin y tế
            </p>

            <div class="row">
                <!-- Reason -->
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Lý do khám</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-question-circle"></i>
                            <input asp-for="Reason" class="form-control" placeholder="Nhập lý do khám..." />
                        </div>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>
                </div>

                <!-- Symptoms -->
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Triệu chứng</label>
                        <textarea asp-for="Symptoms" class="form-control" rows="2" placeholder="Mô tả triệu chứng..."></textarea>
                        <span asp-validation-for="Symptoms" class="text-danger"></span>
                    </div>
                </div>

                <!-- CreatedAt -->
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-6">
                        <div class="form-floating-custom">
                            <label>Ngày tạo</label>
                            <div class="input-icon-wrap">
                                <i class="input-icon fas fa-calendar-plus"></i>
                                <input asp-for="CreatedAt" class="form-control" type="datetime-local" />
                            </div>
                            <span asp-validation-for="CreatedAt" class="text-danger"></span>
                        </div>
                    </div>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <!-- Doctor không nhập -->
                    <input type="hidden" asp-for="CreatedAt" />
                }
            </div>

            <hr style="border-color:#e0faf3;margin:1.5rem 0;">

            <div class="d-flex" style="gap:.75rem">
                <button type="submit" class="btn btn-save-green">
                    <i class="fas fa-check mr-1"></i>Tạo lịch khám
                </button>
                <a asp-action="Index" class="btn btn-cancel-soft">
                    <i class="fas fa-times mr-1"></i>Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}