@model PBL3_HealthCare.Models.Medicine

@{
    ViewData["Title"] = "Xóa thuốc khỏi kho";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/medicines.css" />
}

<a asp-action="Index" class="btn btn-light btn-sm mb-3" style="border-radius:8px;"><i class="fas fa-arrow-left mr-1"></i>Quay lại kho thuốc</a>

<div class="delete-card card mb-4">
    <div class="danger-header">
        <div class="danger-icon"><i class="fas fa-pills"></i></div>
        <h5>Xóa thuốc khỏi kho</h5>
        <p>Hành động này không thể hoàn tác</p>
    </div>
    <div class="delete-body">
        <div class="med-preview">
            <div class="med-icon-wrap"><i class="fas fa-capsules"></i></div>
            <div>
                <div class="med-name">@Model?.Name</div>
                <div class="med-unit"><i class="fas fa-tag mr-1"></i>Đơn vị: @Model?.Unit</div>
            </div>
        </div>

        <div class="info-row">
            <span class="label">Số lượng tồn</span>
            <span class="value">@Model?.StockQuantity @Model?.Unit</span>
        </div>
        <div class="info-row">
            <span class="label">Đơn giá</span>
            <span class="value" style="color:#1cc88a;">@string.Format("{0:N0}", Model?.Price) VNĐ</span>
        </div>

        <div class="warning-box">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            <strong>Cảnh báo:</strong> Thuốc sẽ bị xóa vĩnh viễn khỏi kho. Kiểm tra các đơn thuốc liên quan trước khi xác nhận.
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex" style="gap:.75rem">
                <button type="submit" class="btn btn-confirm-delete"><i class="fas fa-trash mr-1"></i>Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-cancel-soft"><i class="fas fa-ban mr-1"></i>Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>
