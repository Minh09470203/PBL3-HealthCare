@using PBL3_HealthCare.Models
@model IEnumerable<PBL3_HealthCare.Models.Appointment>
@{
    Layout = "_PatientLayout";
    ViewData["Title"] = "Lịch sử khám bệnh";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">DANH SÁCH DỊCH VỤ ĐÃ ĐẶT CỦA TÔI</h6>
    </div>
    <div class="card-body">

        <ul class="nav nav-tabs mb-4" id="historyTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active font-weight-bold" id="appt-tab" data-toggle="tab" href="#appt" role="tab" aria-selected="true">
                    <i class="fas fa-stethoscope mr-1"></i> Khám Bệnh
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link font-weight-bold" id="package-tab" data-toggle="tab" href="#package" role="tab" aria-selected="false">
                    <i class="fas fa-notes-medical mr-1"></i> Gói Khám
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link font-weight-bold" id="vaccine-tab" data-toggle="tab" href="#vaccine" role="tab" aria-selected="false">
                    <i class="fas fa-syringe mr-1"></i> Tiêm Chủng
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link font-weight-bold" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-selected="false">
                    <i class="fas fa-ambulance mr-1"></i> Y Tế Tại Nhà
                </a>
            </li>
        </ul>

        <div class="tab-content" id="historyTabsContent">

            <div class="tab-pane fade show active" id="appt" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle" width="100%" cellspacing="0">
                        <thead class="bg-primary text-white text-center">
                            <tr>
                                <th>Ngày - Giờ khám</th>
                                <th>Bác sĩ</th>
                                <th>Chuyên khoa</th>
                                <th>Trạng thái</th>
                                <th>Hình thức / Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center font-weight-bold">
                                            @item.Date.ToString("dd/MM/yyyy") <br />
                                            <span class="text-danger">@item.TimeSlot.ToString(@"hh\:mm")</span>
                                        </td>
                                        <td>@(item.Doctor?.User?.FullName ?? "Đang chờ phân công")</td>
                                        <td>@(item.Doctor?.Specialty?.Name ?? "N/A")</td>
                                        <td class="text-center">
                                            @if (item.Status == AppointmentStatus.Pending)
                                            {
                                                <span class="badge badge-warning p-2">Chờ duyệt</span>
                                            }
                                            else if (item.Status == AppointmentStatus.Confirmed)
                                            {
                                                <span class="badge badge-success p-2">Đã xác nhận</span>
                                            }
                                            else if (item.Status == AppointmentStatus.Completed)
                                            {
                                                <span class="badge badge-secondary p-2">Đã khám</span>
                                            }
                                            else if (item.Status == AppointmentStatus.Cancelled)
                                            {
                                                <span class="badge badge-danger p-2">Đã hủy</span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            @if (item.IsVideoCall)
                                            {
                                                <span class="badge badge-info p-2 mb-2"><i class="fas fa-video"></i> Khám Online</span>
                                                <br />

                                                @if (item.Status == AppointmentStatus.Confirmed)
                                                {
                                                    var appointmentDateTime = item.Date.ToString("yyyy-MM-dd") + "T" + item.TimeSlot.ToString();
                                                    <a href="/VideoCall/Room?roomId=@item.MeetingRoomId"
                                                       class="btn btn-sm btn-primary btn-join-room disabled"
                                                       data-time="@appointmentDateTime">
                                                        <i class="fas fa-door-open"></i> Vào phòng <br />(<span class="countdown-text">Đang chờ...</span>)
                                                    </a>
                                                }
                                                else if (item.Status == AppointmentStatus.Pending)
                                                {
                                                    <span class="text-muted small italic"><i class="fas fa-info-circle"></i> Link phòng sẽ hiện<br />sau khi được duyệt</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary p-2"><i class="fas fa-hospital"></i> Tại phòng khám</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center font-italic">Bạn chưa có lịch hẹn khám bệnh nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="package" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center" width="100%" cellspacing="0">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Ngày đặt</th>
                                <th>Tên gói khám</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.PackageBookings != null)
                            {
                                foreach (var item in ViewBag.PackageBookings)
                                {
                                    <tr>
                                        <td class="font-weight-bold">@item.BookingDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.HealthPackage?.Name</td>
                                        <td><span class="badge badge-info p-2">@item.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center font-italic">Bạn chưa đăng ký gói khám nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="vaccine" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center" width="100%" cellspacing="0">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Ngày tiêm dự kiến</th>
                                <th>Tên vắc xin</th>
                                <th>Phòng bệnh</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.VaccinationBookings != null)
                            {
                                foreach (var item in ViewBag.VaccinationBookings)
                                {
                                    <tr>
                                        <td class="font-weight-bold">@item.BookingDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.Vaccine?.Name</td>
                                        <td>@item.Vaccine?.DiseasePrevented</td>
                                        <td><span class="badge badge-info p-2">@item.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center font-italic">Bạn chưa đăng ký lịch tiêm chủng nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="home" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center" width="100%" cellspacing="0">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Ngày yêu cầu</th>
                                <th>Dịch vụ</th>
                                <th>Địa chỉ phục vụ</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.HomeServiceRequests != null)
                            {
                                foreach (var item in ViewBag.HomeServiceRequests)
                                {
                                    <tr>
                                        <td class="font-weight-bold">@item.RequestDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.HomeService?.Name</td>
                                        <td>@item.Address</td>
                                        <td><span class="badge badge-info p-2">@item.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center font-italic">Bạn chưa có yêu cầu y tế tại nhà nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkRoomAvailability() {
            const now = new Date();

            document.querySelectorAll('.btn-join-room').forEach(function(btn) {
                const apptTime = new Date(btn.getAttribute('data-time'));
                const diffMs = apptTime - now;
                const diffMins = Math.floor(diffMs / 60000);
                const countdownSpan = btn.querySelector('.countdown-text');

                if (diffMins > 10) {
                    btn.classList.add('disabled');
                    btn.classList.replace('btn-success', 'btn-primary');
                    if (diffMins > 60) {
                        countdownSpan.innerText = `Mở sau ${Math.floor(diffMins/60)}h ${diffMins%60}p`;
                    } else {
                        countdownSpan.innerText = `Mở sau ${diffMins} phút`;
                    }
                }
                else if (diffMins <= 10 && diffMins >= -30) {
                    btn.classList.remove('disabled');
                    btn.classList.replace('btn-primary', 'btn-success');
                    countdownSpan.innerText = "Sẵn sàng!";
                }
                else {
                    btn.classList.add('disabled');
                    btn.classList.replace('btn-success', 'btn-danger');
                    btn.classList.replace('btn-primary', 'btn-danger');
                    countdownSpan.innerText = "Đã quá hạn";
                }
            });
        }

        checkRoomAvailability();
        setInterval(checkRoomAvailability, 60000); // Check lại mỗi 1 phút
    </script>
}