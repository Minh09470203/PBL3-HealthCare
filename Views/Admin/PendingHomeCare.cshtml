@model IEnumerable<PBL3_HealthCare.Models.HomeServiceRequest>
@{
    ViewData["Title"] = "Duyệt Y tế tại nhà";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-house-user text-info"></i> Danh sách Yêu cầu Tại nhà</h1>
</div>

<div class="card shadow mb-4 border-bottom-info">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Bệnh nhân</th>
                        <th>Thông tin liên hệ & Địa chỉ</th>
                        <th>Dịch vụ yêu cầu</th>
                        <th>Thời gian mong muốn</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-dark">@item.Patient?.FullName</td>
                            <td>
                                <i class="fas fa-phone-alt text-success"></i> <strong>@item.Phone</strong> <br />
                                <small class="text-muted"><i class="fas fa-map-marker-alt text-danger"></i> @item.Address</small>
                            </td>
                            <td><span class="badge badge-info p-2">@item.HomeService?.Name</span></td>
                            <td><span class="badge badge-warning text-dark p-2">@item.RequestDate.ToString("dd/MM - HH:mm")</span></td>
                            <td class="text-center">
                                <a asp-action="ApproveHomeCare" asp-route-id="@item.Id" class="btn btn-info btn-sm shadow-sm">
                                    <i class="fas fa-user-nurse"></i> Phân công
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="alert alert-success text-center mt-3">
                    <i class="fas fa-check-circle"></i> Hiện không có yêu cầu y tế tại nhà nào đang chờ.
                </div>
            }
        </div>
    </div>
</div>