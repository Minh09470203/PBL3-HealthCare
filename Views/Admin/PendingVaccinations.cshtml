@model IEnumerable<PBL3_HealthCare.Models.VaccinationBooking>
@{
    ViewData["Title"] = "Quản Lý Tiêm Chủng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-syringe text-success"></i> Điều phối Tiêm Chủng</h1>
</div>

<div class="card shadow mb-4 border-left-primary">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Bệnh nhân</th>
                        <th>Vaccine</th>
                        <th>Ngày đăng ký</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">@item.Patient?.FullName</td>
                            <td><span class="badge badge-info p-2">@item.Vaccine?.Name</span></td>
                            <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge badge-secondary">Chờ duyệt</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge badge-primary">Đã duyệt - Chờ tiêm</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Pending")
                                {
                                    <form asp-action="ApproveVaccine" method="post" style="display:inline;">
                                        <input type="hidden" name="bookingId" value="@item.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm shadow-sm">
                                            <i class="fas fa-check"></i> Duyệt hồ sơ
                                        </button>
                                    </form>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <form asp-action="CompleteVaccination" method="post" style="display:inline;">
                                        <input type="hidden" name="bookingId" value="@item.Id" />
                                        <button type="submit" class="btn btn-success btn-sm shadow-sm">
                                            <i class="fas fa-syringe"></i> Đã tiêm xong
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>