@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Đã gửi liên kết";
    // Gọi giao diện dùng chung ra
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="d-flex flex-column justify-content-center align-items-center h-100 text-center" style="max-width: 450px; margin: 0 auto; width: 100%;">

    <div class="mb-4" style="width: 90px; height: 90px; background-color: rgba(0, 181, 241, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
        <i class="fas fa-paper-plane" style="font-size: 2.5rem; color: #00b5f1;"></i>
    </div>

    <h3 class="fw-bold mb-3" style="color: #1a2a40;">Kiểm tra hộp thư của bạn</h3>

    <p class="text-muted mb-4" style="font-size: 1rem; line-height: 1.6;">
        Chúng tôi đã gửi một liên kết đặt lại mật khẩu an toàn đến email của bạn.<br />
        Vui lòng kiểm tra cả thư mục <strong>Thư rác (Spam)</strong> nếu không tìm thấy nhé!
    </p>

    <a asp-page="./Login" class="w-100 btn btn-pill btn-cyan">
        VỀ TRANG ĐĂNG NHẬP
    </a>
</div>