@page
@model LoginModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-5" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; background: #f4f7f6;">
    <div class="auth-card-v2 shadow-lg p-4 bg-white" style="width: 100%; max-width: 450px; border-radius: 15px;">
        <div class="auth-header text-center">
            <h2>ĐĂNG NHẬP</h2>
            <p class="text-muted">SuperStar Medical Center</p>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center fw-bold">
                @TempData["SuccessMessage"]
            </div>
        }
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Email của bạn" />
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="********" />
            </div>

            <div class="d-flex justify-content-between mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe small">Ghi nhớ</label>
                </div>
                <a href="#" class="small text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-success btn-auth shadow">Đăng nhập</button>

            <div class="text-center mt-4">
                <span class="small">Chưa có tài khoản? <a asp-page="./Register" class="fw-bold text-decoration-none">Đăng ký ngay</a></span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
