@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<<div class="hero-wrap d-flex justify-content-center align-items-start py-5">

    <div class="overlay"></div>

    <div class="container-fluid login-container">

        <div class="row justify-content-center">

            <div class="col-md-5">

                <div class="login-box">

                    <h3 class="text-center mb-4">Đăng ký tài khoản</h3>

                    <form method="post">

                        <div class="form-group">
                            <label>Họ và tên</label>
                            <input asp-for="Input.FullName" class="form-control" placeholder="Nhập họ và tên" />
                        </div>

                        <div class="form-group mt-3">
                            <label>Địa chỉ</label>
                            <input asp-for="Input.Address" class="form-control" placeholder="Nhập địa chỉ" />
                        </div>

                        <div class="form-group mt-3">
                            <label>Ngày sinh</label>
                            <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label>Email</label>
                            <input asp-for="Input.Email" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label>Mật khẩu</label>
                            <input asp-for="Input.Password" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label>Nhập lại mật khẩu</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4">
                            Đăng ký
                        </button>

                        <div class="text-center mt-3">
                            Đã có tài khoản?
                            <a asp-page="/Account/Login">Đăng nhập</a>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
