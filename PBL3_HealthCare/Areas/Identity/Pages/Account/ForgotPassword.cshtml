@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="d-flex flex-column justify-content-center h-100" style="max-width: 420px; margin: 0 auto; width: 100%;">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: #1a2a40; text-transform: uppercase;">QUÊN MẬT KHẨU</h2>
        <p class="text-muted mt-2" style="font-size: 0.95rem;">
            Hãy nhập tên đăng nhập của bạn, chúng tôi sẽ gửi liên kết để đặt lại mật khẩu về email liên kết (nếu có).
        </p>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <div class="form-group mb-4">
            <input asp-for="Input.UserName" class="form-control form-control-pill" autocomplete="username" aria-required="true" placeholder="Nhập tên đăng nhập của bạn..." />
            <span asp-validation-for="Input.UserName" class="text-danger small ms-3 mt-1 d-block"></span>
        </div>

        <button type="submit" class="w-100 btn btn-pill btn-cyan mb-4">
            GỬI LIÊN KẾT ĐẶT LẠI
        </button>

        <div class="text-center">
            <a asp-page="./Login" class="text-decoration-none transition-all" style="color: #00b5f1; font-weight: 600; font-size: 0.95rem;">
                <i class="fas fa-arrow-left me-1"></i> Quay lại trang Đăng nhập
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}