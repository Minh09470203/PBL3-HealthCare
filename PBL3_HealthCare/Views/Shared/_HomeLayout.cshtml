<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Mediplus</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,300,400,500,600,700,800,900" rel="stylesheet">
    <link rel="stylesheet" href="~/mediplus-master/css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="~/mediplus-master/css/animate.css">
    <link rel="stylesheet" href="~/mediplus-master/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/mediplus-master/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/mediplus-master/css/magnific-popup.css">
    <link rel="stylesheet" href="~/mediplus-master/css/aos.css">
    <link rel="stylesheet" href="~/mediplus-master/css/ionicons.min.css">
    <link rel="stylesheet" href="~/mediplus-master/css/flaticon.css">
    <link rel="stylesheet" href="~/mediplus-master/css/icomoon.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/mediplus-master/css/style.css">
    @await RenderSectionAsync("Styles", required: false)    @* ← chuyển lên đây *@
</head>
<body>
    <!-- TOP BAR -->
    <div class="topbar">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md d-flex align-items-center">
                    <div class="icon mr-2"><span class="icon-phone2"></span></div>
                    <span class="text">+ 1235 2355 98</span>
                </div>
                <div class="col-md d-flex align-items-center">
                    <div class="icon mr-2"><span class="icon-paper-plane"></span></div>
                    <span class="text">youremail@email.com</span>
                </div>
                <div class="col-md-5 d-flex justify-content-end align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <partial name="_NotificationBell" />
                        <a asp-controller="Home" asp-action="Profile" class="mr-3">
                            Xin chào, @User.Identity.Name
                        </a>
                        <form asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index","Home",new{area=""})"
                              method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Identity/Account/Register" class="mr-3">Đăng ký</a>
                        <a href="/Identity/Account/Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg ftco_navbar ftco-navbar-light site-navbar-target sticky-top" id="ftco-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">SUPERSTAR</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                    aria-controls="ftco-nav" aria-expanded="false">
                <span class="oi oi-menu"></span>
            </button>
            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a href="#home-section" class="nav-link">Trang chủ</a></li>
                    <li class="nav-item"><a href="#about-section" class="nav-link">Giới thiệu</a></li>
                    <li class="nav-item"><a href="#department-section" class="nav-link">Khoa</a></li>
                    <li class="nav-item"><a href="#doctor-section" class="nav-link">Bác sĩ</a></li>
                    <li class="nav-item"><a href="#contact-section" class="nav-link">Liên hệ</a></li>
                    <li class="nav-item cta mr-md-2">
                        <a asp-controller="Home" asp-action="BookAppointment" class="nav-link">Đặt lịch khám</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()
    <!-- ══════════════════════════════════════
     FOOTER — dùng inline style để tránh bị style.css mediplus override
        ══════════════════════════════════════ -->
    <footer class="ftco-footer ftco-section img" style="background-image:url('/img/footer-bg.jpg');">
        <div class="overlay" style="background:rgba(10,14,30,.88);"></div>
        <div style="position:relative;z-index:2;" class="container-fluid px-md-5">
            <div class="row mb-5 pt-5">

                <!-- SuperStar -->
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 style="font-size:.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:1.1rem;">SuperStar</h2>
                        <p style="color:rgba(255,255,255,.6);font-size:.83rem;line-height:1.75;">Phòng khám đa khoa hàng đầu — tận tâm, chuyên nghiệp, hiệu quả.</p>
                        <div class="d-flex mt-3" style="gap:.4rem;">
                            <a href="https://www.google.com/search?q=%C4%90%E1%BB%99+mixi&sxsrf=ANbL-n6QUMfmPBGUycro3LiJ-9-_tl7etw%3A1774278685439" style="width:34px;height:34px;background:rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.75);text-decoration:none;transition:background .15s;" onmouseover="this.style.background='#3d5ee1'" onmouseout="this.style.background='rgba(255,255,255,.1)'"><span class="icon-google"></span></a>
                            <a href="https://www.facebook.com/MixiGaming" style="width:34px;height:34px;background:rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.75);text-decoration:none;" onmouseover="this.style.background='#3d5ee1'" onmouseout="this.style.background='rgba(255,255,255,.1)'"><span class="icon-facebook"></span></a>
                            <a href="https://www.youtube.com/@@MixiGaming3con" style="width:34px;height:34px;background:rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.75);text-decoration:none;" onmouseover="this.style.background='#3d5ee1'" onmouseout="this.style.background='rgba(255,255,255,.1)'"><span class="icon-youtube"></span></a>
                        </div>
                    </div>
                </div>

                <!-- Chuyên khoa -->
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 style="font-size:.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:1.1rem;">Chuyên khoa</h2>
                        <ul class="list-unstyled" style="margin:0;padding:0;">
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Thần kinh</span></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Nha khoa</span></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Chụp MRI</span></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Ngoại khoa</span></li>
                            <li><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Tim mạch</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Liên kết -->
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 style="font-size:.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:1.1rem;">Liên kết</h2>
                        <ul class="list-unstyled" style="margin:0;padding:0;">
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><a href="#home-section" style="color:rgba(255,255,255,.65);font-size:.83rem;text-decoration:none;">Trang chủ</a></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><a href="#about-section" style="color:rgba(255,255,255,.65);font-size:.83rem;text-decoration:none;">Giới thiệu</a></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><a href="#department-section" style="color:rgba(255,255,255,.65);font-size:.83rem;text-decoration:none;">Khoa</a></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><a href="#doctor-section" style="color:rgba(255,255,255,.65);font-size:.83rem;text-decoration:none;">Bác sĩ</a></li>
                            <li><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><a href="#contact-section" style="color:rgba(255,255,255,.65);font-size:.83rem;text-decoration:none;">Liên hệ</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Dịch vụ -->
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 style="font-size:.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:1.1rem;">Dịch vụ</h2>
                        <ul class="list-unstyled" style="margin:0;padding:0;">
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Dịch vụ cấp cứu</span></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Bác sĩ chuyên môn cao</span></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Khám bệnh ngoại trú</span></li>
                            <li><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Dịch vụ 24 giờ</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Liên hệ -->
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 style="font-size:.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:1.1rem;">Liên hệ</h2>
                        <ul class="list-unstyled" style="margin:0;padding:0;">
                            <li style="margin-bottom:.6rem;display:flex;align-items:flex-start;gap:.5rem;">
                                <span class="icon-map-marker" style="color:rgba(255,255,255,.35);margin-top:.15rem;"></span>
                                <span style="color:rgba(255,255,255,.65);font-size:.83rem;">120 Yên Lãng, Hà Nội</span>
                            </li>
                            <li style="margin-bottom:.6rem;display:flex;align-items:flex-start;gap:.5rem;">
                                <span class="icon-phone" style="color:rgba(255,255,255,.35);margin-top:.15rem;"></span>
                                <span style="color:rgba(255,255,255,.65);font-size:.83rem;">+1235 2355 98</span>
                            </li>
                            <li style="display:flex;align-items:flex-start;gap:.5rem;">
                                <span class="icon-envelope" style="color:rgba(255,255,255,.35);margin-top:.15rem;"></span>
                                <span style="color:rgba(255,255,255,.65);font-size:.83rem;">info@yourdomain.com</span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>

            <!-- Copyright -->
            <div class="row pb-4" style="border-top:1px solid rgba(255,255,255,.08);padding-top:1.25rem;">
                <div class="col-md-12 text-center">
                    <p style="color:rgba(255,255,255,.35);font-size:.8rem;margin:0;">
                        Copyright &copy; <script>document.write(new Date().getFullYear());</script> PBL3 Health Care — by 4thangdaucac
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Loader -->
    <div id="ftco-loader" class="show fullscreen">
        <svg class="circular" width="48px" height="48px">
            <circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee" />
            <circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#3d5ee1" />
        </svg>
    </div>

    <script src="~/mediplus-master/js/jquery.min.js"></script>
    <script src="~/mediplus-master/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="~/mediplus-master/js/popper.min.js"></script>
    <script src="~/mediplus-master/js/bootstrap.min.js"></script>
    <script src="~/mediplus-master/js/jquery.easing.1.3.js"></script>
    <script src="~/mediplus-master/js/jquery.waypoints.min.js"></script>
    <script src="~/mediplus-master/js/jquery.stellar.min.js"></script>
    <script src="~/mediplus-master/js/owl.carousel.min.js"></script>
    <script src="~/mediplus-master/js/jquery.magnific-popup.min.js"></script>
    <script src="~/mediplus-master/js/aos.js"></script>
    <script src="~/mediplus-master/js/jquery.animateNumber.min.js"></script>
    <script src="~/mediplus-master/js/scrollax.min.js"></script>
    <script src="~/mediplus-master/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)   @* ← thêm dòng này *@
</body>
</html>