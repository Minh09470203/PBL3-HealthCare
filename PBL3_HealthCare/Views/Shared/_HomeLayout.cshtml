                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Bác sĩ chuyên môn cao</span></li>
                            <li style="margin-bottom:.45rem;"><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Khám bệnh ngoại trú</span></li>
                            <li><span style="color:rgba(255,255,255,.3);" class="icon-long-arrow-right mr-2"></span><span style="color:rgba(255,255,255,.65);font-size:.83rem;">Dịch vụ 24 giờ</span></li>
