@model PBL3_HealthCare.Models.Appointment

@{
    ViewData["Title"] = "Chi tiết Lịch khám";
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (User.IsInRole("Doctor"))
    {
        Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/appointments.css" />
}

<a asp-action="Index" class="btn btn-light btn-sm mb-3" style="border-radius:8px;"><i class="fas fa-arrow-left mr-1"></i>Quay lại danh sách</a>

<div class="detail-card card mb-4">
    <div class="detail-header">
        <h5><i class="fas fa-calendar-check mr-2"></i>Chi tiết Lịch khám #@Model?.Id</h5>
        <p>Xem thông tin đầy đủ của lịch hẹn</p>
    </div>
    <div class="detail-body">
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label"><i class="fas fa-procedures mr-1"></i>Bệnh nhân</div>
                @* SỬA: Hiện FullName của Bệnh nhân *@
                <div class="info-value font-weight-bold text-dark">@(Model?.Patient?.FullName ?? "N/A")</div>
            </div>
            <div class="info-item green">
                <div class="info-label"><i class="fas fa-user-md mr-1"></i>Bác sĩ</div>
                @* SỬA: Hiện FullName của Bác sĩ *@
                <div class="info-value font-weight-bold text-dark">BS. @(Model?.Doctor?.User?.FullName ?? "N/A")</div>
            </div>
            <div class="info-item yellow">
                <div class="info-label"><i class="fas fa-calendar mr-1"></i>Ngày khám</div>
                <div class="info-value">@Model?.Date.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="info-item teal">
                <div class="info-label"><i class="fas fa-clock mr-1"></i>Khung giờ</div>
                <div class="info-value">@(Model?.TimeSlot.ToString(@"hh\:mm") ?? "—")</div>
            </div>
            <div class="info-item purple">
                <div class="info-label"><i class="fas fa-calendar-plus mr-1"></i>Ngày tạo</div>
                <div class="info-value">@Model?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="info-item red">
                <div class="info-label"><i class="fas fa-traffic-light mr-1"></i>Trạng thái</div>
                <div class="info-value">
                    @if (Model?.Status == AppointmentStatus.Pending)
                    {
                        <span class="status-badge status-pending">
                            <i class="fas fa-hourglass-half mr-1"></i> Chờ duyệt
                        </span>
                    }
                    else if (Model?.Status == AppointmentStatus.Confirmed)
                    {
                        <span class="status-badge status-confirmed">
                            <i class="fas fa-check-circle mr-1"></i> Đã xác nhận
                        </span>
                    }
                    else if (Model?.Status == AppointmentStatus.Cancelled)
                    {
                        <span class="status-badge status-cancelled">
                            <i class="fas fa-times-circle mr-1"></i> Đã hủy
                        </span>
                    }
                    else
                    {
                        <span class="status-badge" style="background:#e8edff;color:#4e73df;">
                            <i class="fas fa-info-circle mr-1"></i> @Model?.Status
                        </span>
                    }
                </div>

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model?.Reason))
        {
            <div class="text-box mb-3">
                <div class="label"><i class="fas fa-question-circle mr-1"></i>Lý do khám</div>
                <p class="text-dark">@Model.Reason</p>
            </div>
        }

        @* Tui giữ lại Symptoms này phòng khi sau này bác sĩ muốn điền thêm triệu chứng lâm sàng vào *@
        @if (!string.IsNullOrWhiteSpace(Model?.Symptoms))
        {
            <div class="text-box">
                <div class="label"><i class="fas fa-notes-medical mr-1"></i>Triệu chứng (Bác sĩ ghi chú)</div>
                <p class="text-dark">@Model.Symptoms</p>
            </div>
        }
    </div>
    <div class="action-bar">
        @if (!User.IsInRole("Doctor"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-edit-action"><i class="fas fa-edit mr-1"></i>Chỉnh sửa</a>
            <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-delete-action"><i class="fas fa-trash mr-1"></i>Xóa</a>
        }
        <a asp-action="Index" class="btn btn-back-action ml-auto"><i class="fas fa-list mr-1"></i>Danh sách</a>
    </div>
</div>