@model IEnumerable<PBL3_HealthCare.Models.Appointment>
@{
    ViewData["Title"] = "Lịch Làm Việc Của Tôi";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    // Gộp lịch khám theo từng ngày để dễ hiển thị
    var groupedSchedule = Model.GroupBy(a => a.Date.Date).ToList();
}

<div class="container-fluid mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-calendar-alt text-primary mr-2"></i>Lịch Làm Việc Sắp Tới</h1>
    </div>

    @if (!groupedSchedule.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="fas fa-mug-hot fa-3x mb-3 text-info"></i>
            <h5 class="font-weight-bold">Hiện tại chưa có lịch làm việc nào sắp tới!</h5>
            <p class="mb-0">Các lịch hẹn được phòng khám xác nhận sẽ tự động hiển thị tại đây.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var dayGroup in groupedSchedule)
            {
                <div class="col-xl-6 col-lg-6 mb-4">
                    <div class="card shadow border-left-primary h-100">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-light">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-calendar-day mr-2"></i>
                                @dayGroup.Key.ToString("dd/MM/yyyy") -
                                @(dayGroup.Key.Date == DateTime.Today ? "Hôm nay" : dayGroup.Key.ToString("dddd"))
                            </h6>
                            <span class="badge badge-primary badge-pill">@dayGroup.Count() ca khám</span>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                @foreach (var item in dayGroup)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-success font-weight-bold mr-3" style="font-size: 1.1rem;">
                                                <i class="fas fa-clock"></i> @Html.DisplayFor(m => item.TimeSlot)
                                            </span>
                                            <span class="text-dark font-weight-bold">
                                                <i class="fas fa-user-injured text-gray-400 mr-1"></i> @(item.Patient?.FullName ?? item.PatientId)
                                            </span>
                                            <br />
                                            <small class="text-muted ml-5"><i class="fas fa-notes-medical"></i> Lý do: @item.Reason</small>
                                        </div>
                                        <a asp-action="Index" class="btn btn-sm btn-outline-info rounded-circle" title="Tới trang quản lý">
                                            <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>