@using PBL3_HealthCare.Models
@model IEnumerable<PBL3_HealthCare.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý Lịch khám";
    Layout = "_AdminLayout";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản lý Lịch khám</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Tạo lịch mới
        </a>
    }
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Bệnh nhân</th>
                        <th>Bác sĩ</th>
                        <th>Ngày khám</th>
                        <th>Trạng thái</th>
                        <th>Ca khám</th>
                        <th>Lý do / Triệu chứng</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@(item.Patient?.FullName ?? "N/A")</strong></td>
                            <td>@(item.Doctor?.User?.FullName ?? "N/A")</td>
                            <td>@item.Date.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == AppointmentStatus.Pending)
                                {
                                    <span class="badge badge-warning p-2">Chờ duyệt</span>
                                }
                                else if (item.Status == AppointmentStatus.Confirmed)
                                {
                                    <span class="badge badge-success p-2">Đã xác nhận</span>
                                }
                                else if (item.Status == AppointmentStatus.Cancelled)
                                {
                                    <span class="badge badge-danger p-2">Đã hủy</span>
                                }
                            </td>
                            <td>@item.TimeSlot</td> 
                            <td>
                                <small><i>@item.Reason</i></small> <br />
                                <span class="text-muted">@item.Symptoms</span>
                            </td>
                            <td class="text-center">
                                @if (User.IsInRole("Doctor"))
                                {
                                    <div class="btn-group">
                                        <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-success btn-sm btn-icon-split shadow-sm mr-2">
                                            <span class="icon text-white-50"><i class="fas fa-check"></i></span>
                                            <span class="text">Duyệt ca</span>
                                        </a>
                                        <a asp-action="Cancel" asp-route-id="@item.Id" class="btn btn-danger btn-sm btn-icon-split shadow-sm">
                                            <span class="icon text-white-50"><i class="fas fa-times"></i></span>
                                            <span class="text">Hủy ca</span>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm shadow-sm" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm shadow-sm" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-circle btn-sm shadow-sm" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                },
                "order": [[2, "desc"]] // Sắp xếp theo ngày mới nhất
            });
        });
    </script>
}