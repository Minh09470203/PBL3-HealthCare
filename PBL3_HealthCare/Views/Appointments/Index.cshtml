@model IEnumerable<PBL3_HealthCare.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý Lịch khám";
    Layout = "_AdminLayout"; // 1. Ốp Layout Admin vào
}

<h1>Quản lý Lịch khám</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>

@* 2. Thêm ID "dataTable" để kích hoạt ô Tìm kiếm *@
<table class="table table-bordered table-hover" id="dataTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Patient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Doctor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSlot)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Symptoms)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Patient.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Doctor.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Reason)
                </td>
                <td>
                    @* 3. Đổ màu Badge cho Status bằng Enum *@
                    @if (item.Status == AppointmentStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Chờ duyệt</span>
                    }
                    else if (item.Status == AppointmentStatus.Confirmed)
                    {
                        <span class="badge bg-success">Đã xác nhận</span>
                    }
                    else if (item.Status == AppointmentStatus.Cancelled)
                    {
                        <span class="badge bg-danger">Đã hủy</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TimeSlot)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Symptoms)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@* 4. Script kích hoạt ô Tìm kiếm và Phân trang (DataTables) *@
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                }
            });
        });
    </script>
}