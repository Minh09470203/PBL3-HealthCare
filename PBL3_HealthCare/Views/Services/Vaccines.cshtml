@model IEnumerable<PBL3_HealthCare.Models.Vaccine>
@{
    ViewData["Title"] = "Danh Mục Tiêm Chủng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/vaccines.css" />
}

<section class="vaccines-page" style="background-color: #f8f9fc; padding-top: 50px; padding-bottom: 60px;">
    <div class="container">

        <div class="vaccines-header text-center mb-5">
            <p class="eyebrow text-primary font-weight-bold text-uppercase" style="letter-spacing: 2px; font-size: 14px;">Dịch vụ y tế</p>
            <h2 style="font-weight: 800; color: #1a202c;">Dịch Vụ Tiêm Chủng</h2>
            <p class="text-muted">Phòng bệnh hơn chữa bệnh. Đăng ký tiêm ngay hôm nay để bảo vệ bản thân và gia đình.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-vac text-center py-5 shadow-sm" style="background: white; border-radius: 16px;">
                <div class="empty-icon" style="font-size: 50px; color: #cbd5e0;"><i class="fas fa-syringe"></i></div>
                <h4 class="mt-3 text-dark">Hiện tại chưa có vaccine nào trong danh mục.</h4>
                <p class="text-muted">Vui lòng quay lại sau nhé!</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-6 col-md-12 mb-4">
                        <div class="vac-card">

                            <div class="vac-body">
                                <div class="vac-name text-primary">@item.Name</div>

                                <div class="vac-info">
                                    <div class="vac-info-row">
                                        <i class="fas fa-shield-virus text-info mr-2"></i>
                                        <span class="info-label text-muted">Phòng bệnh:&nbsp;</span>
                                        <span class="info-val font-weight-bold">@item.DiseasePrevented</span>
                                    </div>
                                    <div class="vac-info-row mt-1">
                                        <i class="fas fa-industry text-secondary mr-2"></i>
                                        <span class="info-label text-muted">Sản xuất:&nbsp;</span>
                                        <span class="info-val">@item.Manufacturer</span>
                                    </div>
                                </div>
                            </div>

                            <div class="vac-footer">
                                <div class="vac-price">
                                    <span class="price-num text-danger" style="font-size: 1.3rem; font-weight: 800;">@item.Price.ToString("N0")</span>
                                    <br />
                                    <span class="price-unit text-muted" style="font-size: 0.85rem;">VNĐ / mũi</span>
                                </div>
                                <a asp-action="BookVaccine" asp-route-id="@item.Id" class="btn-vaccine btn btn-primary font-weight-bold">
                                    <i class="fas fa-calendar-check mr-1"></i> Đăng ký tiêm
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>