@model IEnumerable<PBL3_HealthCare.Models.Doctor>

@{
    ViewData["Title"] = "Quản lý Bác sĩ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/doctors.css" />
}

<div class="page-header">
    <div>
        <h4><i class="fas fa-user-md mr-2 text-primary"></i>Quản lý Bác sĩ</h4>
        <p>Danh sách toàn bộ bác sĩ trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-add">
        <i class="fas fa-plus"></i> Thêm bác sĩ
    </a>
</div>

<div class="data-card card mb-4">
    <div class="card-body">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Chuyên khoa</th>
                    <th>Bằng cấp</th>
                    <th>Giá khám</th>
                    <th class="text-center" style="width:140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div style="width:34px;height:34px;background:linear-gradient(135deg,#4e73df,#224abe);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.75rem;font-weight:700;margin-right:.75rem;flex-shrink:0;">
                                    @(item.User?.FullName?.Length > 0 ? item.User.FullName[0].ToString().ToUpper() : "?")
                                </div>
                                <span class="doctor-name">@Html.DisplayFor(m => item.User.FullName)</span>
                            </div>
                        </td>
                        <td><span class="specialty-pill">@Html.DisplayFor(m => item.Specialty.Name)</span></td>
                        <td>@Html.DisplayFor(m => item.Degree)</td>
                        <td><span class="price-text">@string.Format("{0:N0}", item.Price) <small style="color:#9fa5b5;font-weight:400;">đ</small></span></td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit"><i class="fas fa-edit"></i> Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-detail"><i class="fas fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center"ip>'
            });
        });
    </script>
}
