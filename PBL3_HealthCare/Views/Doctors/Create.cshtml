@model PBL3_HealthCare.Models.Doctor

@{
    ViewData["Title"] = "Thiết lập thông tin Bác sĩ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Thông tin Bác sĩ mới</h6>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UserId" class="control-label font-weight-bold">Tài khoản người dùng</label>
                        <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SpecialtyId" class="control-label font-weight-bold">Chuyên khoa</label>
                        <select asp-for="SpecialtyId" class="form-control" asp-items="ViewBag.SpecialtyId"></select>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Degree" class="control-label font-weight-bold">Bằng cấp/Học hàm</label>
                        <input asp-for="Degree" class="form-control" placeholder="VD: Thạc sĩ, Tiến sĩ..." />
                        <span asp-validation-for="Degree" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Price" class="control-label font-weight-bold">Giá khám (VNĐ)</label>
                        <input asp-for="Price" class="form-control" type="number" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Bio" class="control-label font-weight-bold">Tiểu sử tóm tắt</label>
                        <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <hr />
            <div class="form-group">
                <button type="submit" class="btn btn-primary px-4">Lưu thông tin</button>
                <a asp-action="Index" class="btn btn-secondary px-4 ml-2">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}