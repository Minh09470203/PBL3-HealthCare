@using PBL3_HealthCare.Models
@model IEnumerable<PBL3_HealthCare.Models.Appointment>

@{
    ViewData["Title"] = "Bảng điều khiển Bác sĩ";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(28,200,138,.15);">
        <i class="fas fa-check-circle mr-2"></i> <strong>Thành công!</strong> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(231,74,59,.15);">
        <i class="fas fa-exclamation-triangle mr-2"></i> <strong>Lỗi!</strong> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

    int totalToday = Model.Count();
    int completedToday = Model.Count(a => a.Status == AppointmentStatus.Completed);
    int onlineToday = Model.Count(a => a.IsVideoCall);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/appointments.css" />
    <style>
        .stat-card {
            border: none;
            border-radius: 15px;
            transition: transform 0.2s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .bg-gradient-primary-custom {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            color: white;
        }

        .bg-gradient-success-custom {
            background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
            color: white;
        }

        .bg-gradient-info-custom {
            background: linear-gradient(135deg, #36b9cc 0%, #258391 100%);
            color: white;
        }

        .clock-box {
            font-family: 'Courier New', Courier, monospace;
            font-weight: bold;
            font-size: 1.2rem;
            color: #4e73df;
            background: #f8f9fc;
            padding: 5px 15px;
            border-radius: 10px;
            border: 1px solid #e3e6f0;
        }

        /* Style cho Badge trạng thái chuẩn */
        .badge-waiting {
            background-color: #f6e05e;
            color: #856404;
        }
        /* Vàng cho Chờ duyệt */
        .badge-ready {
            background-color: #c6f6d5;
            color: #22543d;
        }
        /* Xanh lá nhạt cho Đã duyệt */

        .btn-join-blink {
            animation: pulse-blue 2s infinite;
        }

        @@keyframes pulse-blue {
            0% {
                box-shadow: 0 0 0 0 rgba(78, 115, 223, 0.7);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(78, 115, 223, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(78, 115, 223, 0);
            }
        }
    </style>
}

<div class="container-fluid mt-4">
    @* --- Phần Header và Stats giữ nguyên như cũ --- *@
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="font-weight-bold text-gray-800 mb-1">Chào buổi sáng, Bác sĩ!</h4>
            <p class="text-muted small">Đây là lịch trình làm việc của bạn trong ngày hôm nay.</p>
        </div>
        <div class="clock-box shadow-sm">
            <i class="fas fa-clock mr-2"></i><span id="liveClock">00:00:00</span>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card stat-card bg-gradient-primary-custom h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="opacity: 0.8;">Tổng ca khám hôm nay</div>
                            <div class="h5 mb-0 font-weight-bold">@totalToday Ca</div>
                        </div>
                        <div class="col-auto"><i class="fas fa-calendar fa-2x" style="opacity: 0.3;"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card stat-card bg-gradient-success-custom h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="opacity: 0.8;">Đã hoàn thành</div>
                            <div class="h5 mb-0 font-weight-bold">@completedToday / @totalToday</div>
                        </div>
                        <div class="col-auto"><i class="fas fa-check-double fa-2x" style="opacity: 0.3;"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card stat-card bg-gradient-info-custom h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="opacity: 0.8;">Khám Online (Video Call)</div>
                            <div class="h5 mb-0 font-weight-bold">@onlineToday Ca</div>
                        </div>
                        <div class="col-auto"><i class="fas fa-video fa-2x" style="opacity: 0.3;"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- BẢNG DANH SÁCH --- *@
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; overflow: hidden;">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list-ul mr-2"></i>Danh sách bệnh nhân hôm nay</h6>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-light text-primary font-weight-bold">Xem tất cả lịch cũ →</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="todayTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="pl-4">Thời gian</th>
                            <th>Bệnh nhân</th>
                            <th>Hình thức</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="pl-4">
                                    <span class="font-weight-bold text-primary" style="font-size: 1.1rem;">
                                        <i class="far fa-clock mr-1"></i> @item.TimeSlot.ToString(@"hh\:mm")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm mr-3 bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:35px; height:35px;">
                                            <i class="fas fa-user text-muted"></i>
                                        </div>
                                        <strong>@item.Patient?.FullName</strong>
                                    </div>
                                </td>
                                <td>
                                    @if (item.IsVideoCall)
                                    {
                                        <span class="badge badge-info shadow-sm" style="padding: 6px 12px;"><i class="fas fa-video mr-1"></i> Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success shadow-sm" style="padding: 6px 12px;"><i class="fas fa-hospital mr-1"></i> Tại chỗ</span>
                                    }
                                </td>
                                @* 1. CỘT TRẠNG THÁI *@
                                <td>
                                    @{
                                        bool isServiceAppt = item.Reason.Contains("[Gói Khám]") || item.Reason.Contains("[Tại Nhà]") || item.Reason.Contains("[Tiêm Chủng]");
                                    }
                                    @if (item.Status == AppointmentStatus.Pending)
                                    {
                                        <span class="status-badge status-pending">Chờ duyệt</span>
                                    }
                                    else if (item.MedicalRecord == null)
                                    {
                                        <span class="status-badge status-confirmed" style="background-color: #ebf8ff; color: #2b6cb0;">Chưa ghi bệnh án</span>
                                    }
                                    @* 🔥 Nếu là Dịch vụ mà đã có Bệnh án -> Hoàn tất luôn *@
                                    else if (isServiceAppt || (item.MedicalRecord.Prescriptions != null && item.MedicalRecord.Prescriptions.Any()))
                                    {
                                        <span class="status-badge status-confirmed">Đã hoàn tất</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge" style="background-color: #fff3cd; color: #856404;">Chờ kê thuốc</span>
                                    }
                                </td>

                                @* 2. CỘT HÀNH ĐỘNG (QUY TRÌNH 3 BƯỚC) *@
                                <td class="text-center pr-4">
                                    @{
                                        // Nhận diện ca dịch vụ
                                        bool isService = item.Reason.Contains("Gói Khám") || item.Reason.Contains("Tại Nhà") || item.Reason.Contains("[Tiêm Chủng]");
                                    }

                                    @if (item.Status == AppointmentStatus.Pending)
                                    {
                                        <span class="text-warning small font-italic"><i class="fas fa-exclamation-circle mr-1"></i>Đang đợi duyệt...</span>
                                    }
                                    else if (item.MedicalRecord == null)
                                    {
                                        @* --- GIỮ NGUYÊN VIDEO CALL CỦA SẾP TẠI ĐÂY --- *@
                                        if (item.IsVideoCall)
                                        {
                                            var appointmentDateTime = item.Date.ToString("yyyy-MM-dd") + "T" + item.TimeSlot.ToString();
                                            <a href="/VideoCall/Room?roomId=@item.MeetingRoomId"
                                               class="btn btn-primary btn-join-room disabled"
                                               data-time="@appointmentDateTime" style="padding: 5px 15px; border-radius: 20px;">
                                                <i class="fas fa-phone-alt mr-1"></i> <span class="join-text">Vào phòng Video</span>
                                                <small class="countdown-text d-block" style="font-size: 0.65rem;">(Đang chờ...)</small>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="MedicalRecords" asp-action="Create" asp-route-appointmentId="@item.Id"
                                               class="btn btn-success btn-sm rounded-pill px-4">
                                                <i class="fas fa-stethoscope mr-1"></i> Ghi bệnh án
                                            </a>
                                        }
                                    }
                                    @* --- LOGIC DÀNH RIÊNG CHO DỊCH VỤ HOẶC ĐÃ XONG --- *@
                                    else if (isService || (item.MedicalRecord.Prescriptions != null && item.MedicalRecord.Prescriptions.Any()))
                                    {
                                        <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@item.MedicalRecord.Id"
                                           class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                                            <i class="fas fa-eye mr-1"></i> Bệnh án
                                        </a>
                                    }
                                    else
                                    {
                                        @* Chỉ Khám thường mà chưa có đơn thuốc mới hiện nút này *@
                                        <a asp-controller="Prescriptions" asp-action="Create" asp-route-medicalRecordId="@item.MedicalRecord.Id"
                                           class="btn btn-warning btn-sm rounded-pill px-4 text-dark font-weight-bold">
                                            <i class="fas fa-pills mr-1"></i> Kê thuốc
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Copy y nguyên phần Scripts của sếp, tôi chỉ tối ưu hiển thị
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const clockEl = document.getElementById('liveClock');
            if(clockEl) clockEl.textContent = `${hours}:${minutes}:${seconds}`;
        }

        function checkDoctorRoomAvailability() {
            const now = new Date();
            document.querySelectorAll('.btn-join-room').forEach(function(btn) {
                const apptTime = new Date(btn.getAttribute('data-time'));
                const diffMs = apptTime - now;
                const diffMins = Math.floor(diffMs / 60000);
                const countdownSpan = btn.querySelector('.countdown-text');
                const joinText = btn.querySelector('.join-text');

                if (diffMins > 10) {
                    btn.classList.add('disabled');
                    btn.style.backgroundColor = '#858796';
                    countdownSpan.innerText = `(Mở sau ${diffMins} phút)`;
                }
                else if (diffMins <= 10 && diffMins >= -45) {
                    btn.classList.remove('disabled');
                    btn.style.backgroundColor = '#4e73df';
                    btn.classList.add('btn-join-blink');
                    joinText.innerText = "Vào khám ngay!";
                    countdownSpan.innerText = "(Sẵn sàng)";
                }
                else {
                    btn.classList.add('disabled');
                    btn.style.backgroundColor = '#e74a3b';
                    joinText.innerText = "Quá hạn";
                    countdownSpan.innerText = "(Đã hết giờ)";
                }
            });
        }

        setInterval(updateClock, 1000);
        setInterval(checkDoctorRoomAvailability, 30000);
        updateClock();
        checkDoctorRoomAvailability();
    </script>
}