@model IEnumerable<PBL3_HealthCare.Models.Invoice>

@{
    ViewData["Title"] = "Quản lý Thu Ngân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-file-invoice-dollar"></i> Danh sách Hóa đơn thanh toán</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="invoiceTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Bệnh nhân</th>
                        <th>Ngày tạo</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-dark">HD-@item.Id.ToString("D3")</td>
                            <td>@(item.Appointment?.Patient?.FullName ?? "N/A")</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger font-weight-bold">@item.TotalAmount.ToString("N0")đ</td>
                            <td>
                                @if (item.Status == InvoiceStatus.Unpaid)
                                {
                                    <span class="badge badge-warning p-2"><i class="fas fa-clock"></i> Chưa thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge badge-success p-2"><i class="fas fa-check-circle"></i> Đã thanh toán</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == InvoiceStatus.Unpaid)
                                {
                                    <button class="btn btn-sm btn-success btn-collect" data-id="@item.Id">
                                        <i class="fas fa-money-bill-wave"></i> Thu tiền
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary disabled"><i class="fas fa-check"></i> Đã thu</button>
                                }
                                <a href="/Invoices/Print/@item.Id" target="_blank" class="btn btn-sm btn-info">
                                    <i class="fas fa-print"></i> In
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* Đảm bảo đã có thư viện SweetAlert2 trong Layout, nếu chưa thì thêm dòng dưới *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            $('#invoiceTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "order": [[2, "desc"]] // Sắp xếp hóa đơn mới nhất lên đầu
            });

            $('.btn-collect').click(function() {
                let id = $(this).data('id');

                Swal.fire({
                    title: 'Xác nhận thu tiền?',
                    text: "Bạn xác nhận bệnh nhân đã thanh toán hóa đơn này?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#1cc88a',
                    cancelButtonColor: '#858796',
                    confirmButtonText: 'Đồng ý thu tiền',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Invoices/XacNhanThuTien/' + id,
                            type: 'POST',
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Thành công!', res.message, 'success').then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Lỗi!', res.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ', 'error');
                            }
                        });
                    }
                })
            });
        });
    </script>
}