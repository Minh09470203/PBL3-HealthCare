@model PBL3_HealthCare.Models.Invoice
@{
    Layout = null; 
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn chi tiết - @Model.Id</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; }
        .header { text-align: center; margin-bottom: 30px; }
        .section { margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .total { text-align: right; font-weight: bold; font-size: 1.2em; }
        @@media print {
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()">In hóa đơn này</button>
        <hr />
    </div>

    <div class="header">
        <h1>HÓA ĐƠN THANH TOÁN</h1>
        <p>Mã hóa đơn: #@Model.Id | Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <div class="section">
        <h3>Thông tin khách hàng</h3>
        <p>Họ tên: @Model.MedicalRecord?.ApplicationUser?.FullName</p>
        <p>Địa chỉ: @Model.MedicalRecord?.ApplicationUser?.Address</p>
    </div>

    <div class="section">
        <h3>Thông tin chuyên môn</h3>
        <p>Bác sĩ điều trị: @Model.MedicalRecord?.Doctor?.User?.FullName</p>
        <p>Chẩn đoán: @Model.MedicalRecord?.Diagnosis</p>
    </div>

    <div class="section">
        <h3>Chi tiết dịch vụ & Thuốc</h3>
        <table>
            <thead>
                <tr>
                    <th>Nội dung</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Phí khám bệnh</td>
                    <td>1</td>
                    <td>@Model.MedicalRecord?.Doctor?.Price.ToString("N0") VNĐ</td>
                    <td>@Model.MedicalRecord?.Doctor?.Price.ToString("N0") VNĐ</td>
                </tr>
                @if (Model.MedicalRecord?.Prescriptions != null)
                {
                    @foreach (var p in Model.MedicalRecord.Prescriptions)
                    {
                        @foreach (var d in p.PrescriptionDetails)
                        {
                            <tr>
                                <td>@d.Medicine?.Name</td>
                                <td>@d.Quantity</td>
                                <td>@d.Medicine?.Price.ToString("N0") VNĐ</td>
                                <td>@((d.Quantity * (d.Medicine?.Price ?? 0)).ToString("N0")) VNĐ</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <p class="total">TỔNG CỘNG: @Model.TotalAmount.ToString("N0") VNĐ</p>

</body>
</html>