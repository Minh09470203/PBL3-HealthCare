@model PBL3_HealthCare.Models.ApplicationUser

@{
    ViewData["Title"] = "Hồ sơ Quản trị viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor/doctor-profile.css" />
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-user-shield text-primary mr-2"></i>Hồ sơ Quản trị viên
    </h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success-custom">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

<form asp-action="Profile" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row">

        @* ── LEFT: Avatar + quick info ── *@
        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="profile-avatar-card card">
                <div class="card-header">
                    <h6><i class="fas fa-camera mr-1"></i>Ảnh đại diện</h6>
                </div>
                <div class="card-body">
                    @{
                        // Kiểm tra xem Model có ảnh chưa, có thì lấy, chưa có thì dùng ảnh mặc định
                        var avatarSrc = !string.IsNullOrEmpty(Model.Avatar)
                        ? $"/img/admins/{Model.Avatar}"
                        : "/img/admins/default-admin.jpg";
                    }

                    <div class="avatar-wrap" onclick="document.getElementById('avatarInput').click()">
                        <img src="@avatarSrc" id="avatarPreview"
                             alt="@Model.FullName"
                             onerror="this.src='/img/doctors/default.jpg'" />
                        <div class="avatar-overlay">
                            <i class="fas fa-camera"></i>
                            <span>Đổi ảnh</span>
                        </div>
                    </div>

                    <div class="doctor-name">@Model.FullName</div>
                    <div class="doctor-role text-danger font-weight-bold">Quản trị viên Hệ thống</div>

                    @* File upload *@
                    <div class="upload-zone">
                        <input type="file" name="AvatarFile" id="avatarInput"
                               accept="image/*" onchange="previewAvatar(this)" />
                        <span class="upload-text" id="uploadLabel">Tải ảnh mới lên...</span>
                        <span class="upload-btn">Chọn ảnh</span>
                    </div>

                    <div class="border-top pt-3">
                        <a asp-controller="Home" asp-action="ChangePassword"
                           class="btn-change-pass">
                            <i class="fas fa-key mr-1"></i>Đổi mật khẩu
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* ── RIGHT: Forms ── *@
        <div class="col-xl-8 col-lg-7">

            @* ── Block 1: Thông tin tài khoản ── *@
            <div class="info-card card">
                <div class="card-header">
                    <h6><i class="fas fa-id-card mr-1"></i>Thông tin cá nhân</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="field-group">
                                <label class="field-label">Họ và tên <span class="req">*</span></label>
                                <input type="text" name="FullName" class="form-control-custom"
                                       value="@Model.FullName" placeholder="Nguyễn Văn A" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="field-group">
                                <label class="field-label">Tên đăng nhập</label>
                                <input type="text" class="form-control-custom"
                                       value="@Model.UserName"
                                       readonly
                                       style="background:#f8f9fa;color:#6c757d;cursor:not-allowed;"
                                       title="Không thể thay đổi tên đăng nhập" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="field-group">
                                <label class="field-label">Số điện thoại</label>
                                <input type="tel" name="PhoneNumber" class="form-control-custom"
                                       value="@Model.PhoneNumber"
                                       placeholder="Nhập số điện thoại" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="field-group">
                                <label class="field-label">Địa chỉ</label>
                                <input type="text" name="Address" class="form-control-custom"
                                       value="@Model.Address"
                                       placeholder="Số nhà, đường, phường/xã..." />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="field-group">
                                <label class="field-label">Email liên kết (Dùng để lấy lại mật khẩu)</label>
                                @{
                                    var displayEmail = (Model.Email != null && Model.Email.EndsWith("@system.local")) ? "" : Model.Email;
                                }
                                <input type="email" name="Email" class="form-control-custom"
                                       value="@displayEmail"
                                       placeholder="Nhập email của bạn..." />
                                @if (!string.IsNullOrEmpty(displayEmail))
                                {
                                    if (Model.EmailConfirmed)
                                    {
                                        <small class="text-success mt-1 d-block"><i class="fas fa-check-circle"></i> Đã xác thực</small>
                                    }
                                    else
                                    {
                                        <small class="text-danger mt-1 d-block"><i class="fas fa-exclamation-triangle"></i> Chưa xác thực. Vui lòng kiểm tra hộp thư.</small>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-3 mt-2">
                        <button type="submit" class="btn-save">
                            <i class="fas fa-save mr-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewAvatar(input) {
            if (!input.files || !input.files[0]) return;
            var file = input.files[0];
            document.getElementById('uploadLabel').textContent = file.name;
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('avatarPreview').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    </script>
}