@using PBL3_HealthCare.Models
@{
    ViewData["Title"] = "Dashboard Quản Trị";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Tổng quan hệ thống</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Báo cáo thống kê hệ thống (Dữ liệu thực tế)</li>
    </ol>

    <div class="row">
        <div class="col-xl-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i> Thống kê doanh thu (VNĐ)
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" width="100%" height="40"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-pie me-1"></i> Tỷ lệ Bệnh nhân theo Chuyên khoa
                </div>
                <div class="card-body">
                    <canvas id="specialtyChart" width="100%" height="40"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Thư viện Chart.js *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            // Gọi API từ AdminController để lấy dữ liệu thật từ BE
            $.get('/Admin/GetChartData', function (res) {

                // 1. Vẽ Biểu đồ Cột - Doanh thu từ Database
                const ctxBar = document.getElementById('revenueChart');
                new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: res.barChartData.map(x => "Tháng " + x.month),
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            backgroundColor: 'rgba(2, 117, 216, 1)',
                            borderColor: 'rgba(2, 117, 216, 1)',
                            data: res.barChartData.map(x => x.total), // Dữ liệu thật từ BE
                        }],
                    },
                    options: {
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });

                // 2. Vẽ Biểu đồ Tròn - Tỷ lệ bệnh nhân thật
                const ctxPie = document.getElementById('specialtyChart');
                new Chart(ctxPie, {
                    type: 'doughnut',
                    data: {
                        labels: res.pieChartData.map(x => x.specialtyName),
                        datasets: [{
                            data: res.pieChartData.map(x => x.patientCount), // Số lượng thật từ BE
                            backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'],
                        }],
                    }
                });
            }).fail(function() {
                console.error("Không thể kết nối với API GetChartData. Kiểm tra lại Controller!");
            });
        });
    </script>
}