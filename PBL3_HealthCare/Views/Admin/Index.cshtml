@{
    ViewData["Title"] = "Dashboard Quản Trị";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Tổng quan hệ thống</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Báo cáo thống kê hệ thống</li>
    </ol>

    <div class="row">
        <div class="col-xl-8">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i> Thống kê doanh thu (VNĐ)
                </div>
                <div class="card-body"><canvas id="revenueChart" width="100%" height="40"></canvas></div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-pie me-1"></i> Tỷ lệ Bệnh nhân theo Chuyên khoa
                </div>
                <div class="card-body"><canvas id="specialtyChart" width="100%" height="40"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // 1. Vẽ Biểu đồ Doanh thu (Dữ liệu mẫu để Thái demo)
        const ctxBar = document.getElementById('revenueChart');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4'],
                datasets: [{
                    label: 'Doanh thu',
                    backgroundColor: 'rgba(2,117,216,1)',
                    borderColor: 'rgba(2,117,216,1)',
                    data: [4215, 5312, 6251, 7841], // Sau này Minh BE sẽ đổ data thật vào đây
                }],
            }
        });

        // 2. Vẽ Biểu đồ Tròn
        const ctxPie = document.getElementById('specialtyChart');
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: ['Nội khoa', 'Ngoại khoa', 'Nhi khoa', 'Răng Hàm Mặt'],
                datasets: [{
                    data: [25, 15, 30, 30],
                    backgroundColor: ['#007bff', '#dc3545', '#ffc107', '#28a745'],
                }],
            }
        });
    </script>
}