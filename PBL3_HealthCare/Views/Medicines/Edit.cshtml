@model PBL3_HealthCare.Models.Medicine

@{
    ViewData["Title"] = "Cập nhật thông tin thuốc";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/medicines.css" />
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-light btn-sm mr-3" style="border-radius:8px;"><i class="fas fa-arrow-left mr-1"></i>Quay lại kho</a>
    <span class="med-id-badge"><i class="fas fa-fingerprint mr-1"></i>Thuốc #@Model?.Id</span>
</div>

<div class="form-card edit card mb-4" style="max-width:720px;">
    <div class="card-header">
        <h5><i class="fas fa-edit mr-2"></i>Cập nhật thông tin thuốc</h5>
        <p>Điều chỉnh thông tin: @Model?.Name</p>
    </div>
    <div class="card-body">
        <form asp-action="Edit" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="border-radius:10px;font-size:.85rem;"></div>
            <input type="hidden" asp-for="Id" />

            <p class="form-section-title yellow"><i class="fas fa-capsules mr-1"></i>Thông tin thuốc</p>
            <div class="row">
                <div class="col-md-8">
                    <div class="form-floating-custom">
                        <label>Tên thuốc</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-capsules"></i>
                            <input asp-for="Name" class="form-control" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating-custom">
                        <label>Đơn vị tính</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-tag"></i>
                            <input asp-for="Unit" class="form-control" />
                        </div>
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Số lượng tồn kho</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-cubes"></i>
                            <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                        </div>
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Đơn giá (VNĐ)</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-money-bill"></i>
                            <input asp-for="Price" class="form-control" type="number" min="0" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr style="border-color:#fff8e0;margin:1.5rem 0;">
            <div class="d-flex" style="gap:.75rem">
                <button type="submit" class="btn btn-save-yellow"><i class="fas fa-save mr-1"></i>Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-cancel-soft"><i class="fas fa-times mr-1"></i>Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
