@model PBL3_HealthCare.Models.Schedule

@{
    ViewData["Title"] = "Chỉnh sửa Ca làm việc";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/schedules.css" />
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-light btn-sm mr-3" style="border-radius:8px;"><i class="fas fa-arrow-left mr-1"></i>Quay lại</a>
    <span class="id-badge"><i class="fas fa-fingerprint mr-1"></i>Ca #@Model?.Id</span>
</div>

<div class="form-card edit card mb-4" style="max-width:680px;">
    <div class="card-header">
        <h5><i class="fas fa-calendar-edit mr-2"></i>Chỉnh sửa Ca làm việc</h5>
        <p>Cập nhật phân công ca trực</p>
    </div>
    <div class="card-body">
        <form asp-action="Edit" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="border-radius:10px;font-size:.85rem;"></div>
            <input type="hidden" asp-for="Id" />

            <p class="form-section-title yellow"><i class="fas fa-user-md mr-1"></i>Thông tin ca làm</p>

            <div class="form-floating-custom">
                <label>Bác sĩ phụ trách</label>
                <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId"></select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Ngày làm việc</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-calendar"></i>
                            <input asp-for="Date" class="form-control" type="date" />
                        </div>
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Ca làm việc</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-sun"></i>
                            <input asp-for="Shift" class="form-control" />
                        </div>
                        <span asp-validation-for="Shift" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="availability-toggle">
                <input class="form-check-input" type="checkbox" asp-for="IsAvailable" />
                <div>
                    <label asp-for="IsAvailable" style="font-size:.9rem;font-weight:600;color:#2d3748;cursor:pointer;margin:0;">Còn chỗ nhận lịch</label>
                    <div style="font-size:.78rem;color:#9fa5b5;">Bật nếu bác sĩ có thể nhận thêm bệnh nhân</div>
                </div>
            </div>

            <hr style="border-color:#fff8e0;margin:1.5rem 0;">
            <div class="d-flex" style="gap:.75rem">
                <button type="submit" class="btn btn-save-yellow"><i class="fas fa-save mr-1"></i>Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-cancel-soft"><i class="fas fa-times mr-1"></i>Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
