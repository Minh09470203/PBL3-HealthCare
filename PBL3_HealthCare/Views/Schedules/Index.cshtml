@model IEnumerable<PBL3_HealthCare.Models.Schedule>

@{
    ViewData["Title"] = "Quản lý Ca làm việc";
    Layout = "_AdminLayout";
}

<h1>Quản lý Ca làm việc</h1>

<table class="table table-bordered table-hover" id="dataTable">
    <thead>
        <tr>
            <th>Bác sĩ</th>
            <th>@Html.DisplayNameFor(model => model.Date)</th>
            <th>@Html.DisplayNameFor(model => model.Shift)</th> @* Đã sửa thành Shift *@
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Doctor?.User?.FullName</td>
                <td>@item.Date.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(modelItem => item.Shift)</td> @* Đã sửa thành Shift *@
                <td>
                    @if (item.IsAvailable)
                    {
                        <span class="badge bg-success">Còn trống</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã kín</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" }
            });
        });
    </script>
}