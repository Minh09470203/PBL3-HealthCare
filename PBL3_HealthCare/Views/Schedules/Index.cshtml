@model IEnumerable<PBL3_HealthCare.Models.Schedule>

@{
    ViewData["Title"] = "Quản lý Ca làm việc";
    Layout = "_AdminLayout";
}

@section Styles {
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
    <link rel="stylesheet" href="~/css/admin/schedules.css" />
    <style>
        /* CSS bổ sung cho Task 5 */
        .view-switcher {
            background: #f8f9fc;
            padding: 5px;
            border-radius: 12px;
            display: inline-flex;
            gap: 5px;
            border: 1px solid #e3e6f0;
        }

        .btn-view {
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #858796;
            background: transparent;
            transition: all 0.2s;
        }

            .btn-view.active {
                background: #fff;
                color: #36b9cc;
                box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            }

        #calendar {
            background: #fff;
            padding: 20px;
            border-radius: 16px;
        }

        /* Tùy chỉnh màu sắc Event trên lịch */
        .fc-event {
            border: none !important;
            padding: 3px 8px !important;
            border-radius: 6px !important;
            font-size: 0.8rem !important;
        }

        .event-morning {
            background-color: #36b9cc !important;
        }

        .event-afternoon {
            background-color: #4e73df !important;
        }

        .event-default {
            background-color: #1cc88a !important;
        }

        .fc-toolbar-title {
            font-size: 1.1rem !important;
            font-weight: 700 !important;
            color: #4e73df;
        }
    </style>
}

<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4><i class="fas fa-calendar-alt mr-2" style="color:#36b9cc;"></i>Lịch Trực Bác Sĩ</h4>
        <p>Phân công và quản lý ca làm việc trực quan</p>
    </div>

    <div class="d-flex align-items-center" style="gap: 15px;">
        <div class="view-switcher">
            <button class="btn-view active" id="viewCalendar"><i class="fas fa-calendar-day mr-1"></i> Lịch</button>
            <button class="btn-view" id="viewTable"><i class="fas fa-list mr-1"></i> Bảng</button>
        </div>

        <a asp-action="Create" class="btn btn-add">
            <i class="fas fa-plus"></i> Thêm ca làm việc
        </a>
    </div>
</div>

<div id="calendarContainer" class="data-card card mb-4">
    <div class="card-body" style="padding: 20px;">
        <div id='calendar'></div>
    </div>
</div>

<div id="tableContainer" class="data-card card mb-4" style="display:none;">
    <div class="card-body">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Bác sĩ</th>
                    <th>Ngày làm việc</th>
                    <th>Ca làm</th>
                    <th>Trạng thái</th>
                    <th class="text-center" style="width:130px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div style="width:32px;height:32px;background:linear-gradient(135deg,#36b9cc,#258391);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.72rem;font-weight:700;margin-right:.65rem;flex-shrink:0;">
                                    @(item.Doctor?.User?.FullName?.Length > 0 ? item.Doctor.User.FullName[0].ToString().ToUpper() : "?")
                                </div>
                                <span class="doctor-name">@item.Doctor?.User?.FullName</span>
                            </div>
                        </td>
                        <td><span class="date-text">@item.Date.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="shift-pill"><i class="fas fa-sun mr-1"></i>@item.Shift</span></td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="avail-badge avail-yes"><i class="fas fa-check-circle mr-1"></i>Còn trống</span>
                            }
                            else
                            {
                                <span class="avail-badge avail-no"><i class="fas fa-times-circle mr-1"></i>Đã kín</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit" title="Sửa"><i class="fas fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete" title="Xóa"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/vi.js'></script>

    <script>
        $(document).ready(function () {
            // 1. Khởi tạo DataTable (Giữ nguyên của Thái)
            var table = $('#dataTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center"ip>'
            });

            // 2. Khởi tạo FullCalendar (Task 5)
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'vi',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listMonth'
                },
                events: [
                    @foreach (var item in Model)
                    {
                            <text>{
                                title: '@item.Shift: @(item.Doctor?.User?.FullName)',
                                start: '@item.Date.ToString("yyyy-MM-dd")',
                                className: '@(item.Shift.Contains("Sáng") ? "event-morning" : item.Shift.Contains("Chiều") ? "event-afternoon" : "event-default")',
                                url: '@Url.Action("Edit", new { id = item.Id })'
                            },</text>
                    }
                ],
                eventClick: function(info) {
                    if (info.event.url) {
                        window.location.href = info.event.url;
                        return false;
                    }
                }
            });
            calendar.render();

            // 3. Logic chuyển đổi giữa Calendar và Table
            $('#viewCalendar').click(function() {
                $(this).addClass('active');
                $('#viewTable').removeClass('active');
                $('#calendarContainer').fadeIn();
                $('#tableContainer').hide();
                calendar.render(); // Cần render lại để lịch hiển thị đúng size
            });

            $('#viewTable').click(function() {
                $(this).addClass('active');
                $('#viewCalendar').removeClass('active');
                $('#tableContainer').fadeIn();
                $('#calendarContainer').hide();
            });
        });
    </script>
}