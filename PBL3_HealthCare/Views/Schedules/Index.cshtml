@model IEnumerable<PBL3_HealthCare.Models.Schedule>

@{
    ViewData["Title"] = "Quản lý Ca làm việc";
    // 1. TỰ ĐỘNG CHUYỂN LAYOUT THEO ROLE
    if (User.IsInRole("Doctor"))
    {
        Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/schedules.css" />
}

<style>
    /* ... (Giữ nguyên toàn bộ phần CSS cực xịn của sếp) ... */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

        .page-header h4 {
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        .page-header p {
            color: #9fa5b5;
            font-size: .85rem;
            margin: .25rem 0 0;
        }

    .btn-add {
        background: linear-gradient(135deg,#36b9cc,#258391);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .6rem 1.4rem;
        font-weight: 600;
        font-size: .88rem;
        box-shadow: 0 4px 12px rgba(54,185,204,.3);
        transition: transform .15s;
    }

        .btn-add:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .data-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(54,185,204,.08);
        overflow: hidden;
    }

        .data-card .card-body {
            padding: 0;
        }

    table.dataTable thead th {
        background: #f0fbfc;
        color: #5a5c69;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .8px;
        font-weight: 700;
        border-bottom: 2px solid #e0f7fa !important;
        border-top: none !important;
        padding: 1rem 1.25rem !important;
    }

    table.dataTable tbody td {
        padding: .85rem 1.25rem !important;
        vertical-align: middle;
        font-size: .88rem;
        color: #2d3748;
        border-bottom: 1px solid #f0f2fa !important;
    }

    table.dataTable tbody tr:hover td {
        background: #f0fbfc;
    }

    table.dataTable tbody tr:last-child td {
        border-bottom: none !important;
    }

    .doctor-name {
        font-weight: 700;
        color: #2d3748;
    }

    .date-text {
        font-weight: 600;
    }

    .shift-pill {
        background: #e0f7fa;
        color: #258391;
        padding: .25rem .75rem;
        border-radius: 15px;
        font-size: .78rem;
        font-weight: 700;
        display: inline-block;
    }

    .avail-badge {
        display: inline-flex;
        align-items: center;
        padding: .3rem .75rem;
        border-radius: 15px;
        font-size: .75rem;
        font-weight: 700;
    }

    .avail-yes {
        background: #e8fdf5;
        color: #0a5f38;
        border: 1.5px solid #a3e9c6;
    }

    .avail-no {
        background: #f0f0f0;
        color: #6c757d;
        border: 1.5px solid #dee2e6;
    }

    .btn-action {
        border-radius: 8px;
        padding: .3rem .7rem;
        font-size: .78rem;
        font-weight: 600;
        border: none;
        transition: transform .1s;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }

        .btn-action:hover {
            transform: translateY(-1px);
        }

    .btn-action-edit {
        background: #fff8e0;
        color: #b8860b;
    }

    .btn-action-detail {
        background: #e0f7fa;
        color: #258391;
    }

    .btn-action-delete {
        background: #fde8e6;
        color: #e74a3b;
    }

    .dataTables_wrapper .dataTables_filter input {
        border: 1.5px solid #e3e6f0;
        border-radius: 10px;
        padding: .4rem .9rem;
        font-size: .85rem;
    }

    .dataTables_wrapper .dataTables_length select {
        border: 1.5px solid #e3e6f0;
        border-radius: 8px;
        padding: .3rem .6rem;
        font-size: .85rem;
    }

    .dataTables_wrapper {
        padding: 1.25rem;
    }

    .dataTables_info, .dataTables_paginate {
        padding: .75rem 0 0 !important;
    }
</style>

<div class="page-header">
    <div>
        <h4><i class="fas fa-clock mr-2" style="color:#36b9cc;"></i>Quản lý Ca làm việc</h4>
        <p>Lịch phân công ca trực của các bác sĩ</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-add">
            <i class="fas fa-plus"></i> Thêm ca làm việc
        </a>
    }
</div>

<div class="data-card card mb-4">
    <div class="card-body">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Bác sĩ</th>
                    <th>Ngày làm việc</th>
                    <th>Ca làm</th>
                    <th>Trạng thái</th>
                    <th class="text-center" style="width:130px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div style="width:32px;height:32px;background:linear-gradient(135deg,#36b9cc,#258391);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.72rem;font-weight:700;margin-right:.65rem;flex-shrink:0;">
                                    @(item.Doctor?.User?.FullName?.Length > 0 ? item.Doctor.User.FullName[0].ToString().ToUpper() : "?")
                                </div>
                                <span class="doctor-name">@item.Doctor?.User?.FullName</span>
                            </div>
                        </td>
                        <td><span class="date-text">@item.Date.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="shift-pill"><i class="fas fa-sun mr-1"></i>@Html.DisplayFor(m => item.Shift)</span></td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="avail-badge avail-yes"><i class="fas fa-check-circle mr-1"></i>Còn trống</span>
                            }
                            else
                            {
                                <span class="avail-badge avail-no"><i class="fas fa-times-circle mr-1"></i>Đã kín</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit" title="Sửa"><i class="fas fa-edit"></i></a>
                            }

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-detail" title="Chi tiết"><i class="fas fa-eye"></i></a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete" title="Xóa"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center"ip>'
            });
        });
    </script>
}