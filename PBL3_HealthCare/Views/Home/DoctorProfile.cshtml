@model PBL3_HealthCare.Models.Doctor
@{
    ViewData["Title"] = "Hồ sơ Bác sĩ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var next3Days = ViewBag.Next3Days as List<DateTime>;
    var timeSlots = ViewBag.TimeSlots as List<string>;
    var bookedAppointments = ViewBag.BookedAppointments as List<PBL3_HealthCare.Models.Appointment>;
}

<div class="container mt-5 pt-5 mb-5">
    <div class="row bg-white p-4 shadow rounded">
        <div class="col-md-5 d-flex flex-column align-items-center text-center border-right pr-4">
            <img src="/images/doctors/@(Model.Image ?? "default.jpg")" alt="Avatar" class="rounded-circle mb-3 shadow-sm" style="width: 180px; height: 180px; object-fit: cover;">
            <h3 class="mb-1 font-weight-bold">BS. @Model.User?.FullName</h3>
            <h5 class="text-primary mb-3">@Model.Specialty?.Name</h5>
            <p class="text-muted text-justify">Bác sĩ chuyên khoa @Model.Specialty?.Name với nhiều năm kinh nghiệm tại các bệnh viện lớn. Luôn tận tâm, nhiệt tình và đặt sức khỏe bệnh nhân lên hàng đầu.</p>
            <div class="w-100 text-left mt-3">
                <p><i class="icon-map-marker text-danger mr-2"></i> Phòng khám SuperStar, 120 Yên Lãng</p>
                <p><i class="icon-money text-success mr-2"></i> Giá khám: <b>300.000đ</b></p>
            </div>
        </div>

        <div class="col-md-7 pl-md-5 mt-4 mt-md-0">
            <h5 class="text-uppercase mb-3 font-weight-bold"><i class="icon-calendar mr-2"></i> Lịch Khám</h5>

            <ul class="nav nav-tabs mb-4" id="scheduleTab" role="tablist">
                @for (int i = 0; i < next3Days.Count; i++)
                {
                    <li class="nav-item">
                        <a class="nav-link @(i == 0 ? "active" : "") font-weight-bold" id="day-@(i)-tab" data-toggle="tab" href="#day-@(i)" role="tab">
                            @(i == 0 ? "Hôm nay" : next3Days[i].ToString("dd/MM"))
                        </a>
                    </li>
                }
            </ul>

            <div class="tab-content" id="scheduleTabContent">
                @for (int i = 0; i < next3Days.Count; i++)
                {
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="day-@(i)" role="tabpanel">
                        <div class="d-flex flex-wrap">
                            @foreach (var slot in timeSlots)
                            {
                                // ÉP KIỂU TIMESPAN ĐỂ TRÁNH LỖI CRASH C#
                                bool isBooked = bookedAppointments.Any(a => a.Date.Date == next3Days[i].Date && a.TimeSlot == TimeSpan.Parse(slot));

                                if (isBooked)
                                {
                                    <button class="btn btn-light border m-1" disabled style="width: 110px; opacity: 0.6; text-decoration: line-through;">@slot</button>
                                }
                                else
                                {
                                    <a asp-controller="Home" asp-action="BookAppointment"
                                       asp-route-doctorId="@Model.Id"
                                       asp-route-date="@next3Days[i].ToString("yyyy-MM-dd")"
                                       asp-route-timeSlot="@slot"
                                       class="btn btn-outline-primary m-1 font-weight-bold" style="width: 110px;">@slot</a>
                                }
                            }
                        </div>
                        <div class="mt-4 p-3 bg-light rounded">
                            <p class="mb-0 text-muted"><small>Chọn <i class="icon-hand-pointer-o text-primary mx-1"></i> một khung giờ để tiến hành đặt lịch.</small></p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>