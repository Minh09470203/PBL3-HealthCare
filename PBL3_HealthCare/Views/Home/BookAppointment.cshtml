@using Microsoft.AspNetCore.Identity
@using PBL3_HealthCare.Models
@inject UserManager<ApplicationUser> UserManager

@model PBL3_HealthCare.Models.Appointment
@{
    ViewData["Title"] = "Xác nhận đặt lịch khám";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var fullName = UserManager.GetUserAsync(User).Result?.FullName ?? "";
    var email = UserManager.GetUserAsync(User).Result?.Email ?? "";

    // Task 1: Kiểm tra xem có phải khám Video không
    var isVideoCall = Context.Request.Query["type"] == "video";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/booking.css" />
    <style>
        .video-call-alert {
            background: #e7f3ff;
            border: 2px dashed #3d5ee1;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            text-align: center;
        }

            .video-call-alert h5 {
                color: #3d5ee1;
                font-weight: 800;
                margin-bottom: 5px;
                text-transform: uppercase;
            }
    </style>
}

<section class="booking-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <div class="booking-card">

                    @* Header *@
                    <div class="booking-header">
                        <h4><i class="icon-calendar mr-2"></i>Xác nhận đặt lịch khám</h4>
                        <p>Kiểm tra thông tin và hoàn tất đặt lịch</p>
                    </div>

                    <div class="booking-body">

                        @* Task 1: Hiển thị thông báo nếu là khám Video *@
                        @if (isVideoCall)
                        {
                            <div class="video-call-alert">
                                <h5><i class="fas fa-video mr-2"></i>Khám Online Qua Video</h5>
                                <p class="small mb-0 text-muted">Bạn sẽ nhận được link phòng họp sau khi bác sĩ xác nhận.</p>
                            </div>
                        }

                        @* Appointment summary *@
                        <div class="appt-summary">
                            <div class="summary-label">Thông tin lịch hẹn</div>

                            <div class="appt-row">
                                <div class="appt-icon"><i class="fas fa-user-md"></i></div>
                                <span class="appt-key">Bác sĩ</span>
                                <span class="appt-val">@ViewBag.DoctorName</span>
                            </div>
                            <div class="appt-row">
                                <div class="appt-icon"><i class="fas fa-calendar-alt"></i></div>
                                <span class="appt-key">Ngày khám</span>
                                <span class="appt-val">@ViewBag.DisplayDate</span>
                            </div>
                            <div class="appt-row">
                                <div class="appt-icon"><i class="fas fa-clock"></i></div>
                                <span class="appt-key">Khung giờ</span>
                                <span class="appt-val">
                                    <span class="timeslot-badge">@Model.TimeSlot.ToString(@"hh\:mm")</span>
                                </span>
                            </div>
                        </div>

                        @* Form *@
                        <form asp-controller="Home" asp-action="BookAppointment" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="DoctorId" />
                            <input type="hidden" asp-for="Date" />
                            <input type="hidden" name="TimeSlot" value="@Model.TimeSlot.ToString(@"hh\:mm")" />

                            @* Gửi kèm loại hình khám để Backend xử lý *@
                            @if (isVideoCall)
                            {
                                <input type="hidden" name="AppointmentType" value="VideoCall" />
                            }

                            <p class="form-section-title">Hồ sơ bệnh nhân</p>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert-danger">
                                    <div asp-validation-summary="All" class="mb-0"></div>
                                </div>
                            }

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating-custom">
                                        <label>Họ và tên</label>
                                        <input type="text" class="form-control readonly-field"
                                               value="@fullName" readonly />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating-custom">
                                        <label>Email</label>
                                        <input type="text" class="form-control readonly-field"
                                               value="@email" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating-custom">
                                <label>
                                    Triệu chứng / Lý do khám
                                    <span style="color:#c92a2a;">*</span>
                                </label>
                                <textarea asp-for="Reason" class="form-control" rows="4" required
                                          placeholder="Ví dụ: Đau đầu kéo dài, sốt cao, cần tư vấn nhổ răng khôn..."></textarea>
                                <div class="form-hint">Mô tả rõ triệu chứng giúp bác sĩ chẩn đoán sơ bộ tốt hơn.</div>
                            </div>

                            <div style="margin-top:1.5rem;">
                                <button type="submit" class="btn-submit">
                                    Hoàn tất đặt lịch
                                </button>
                                <p class="submit-note">
                                    <i class="fas fa-check-circle"></i>Đặt lịch hoàn toàn miễn phí
                                </p>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>