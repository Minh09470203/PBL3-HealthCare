@model PBL3_HealthCare.Models.Appointment
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đặt lịch khám";
}

@* Phần Hero Section giữ nguyên giao diện của bạn *@
<section class="hero-wrap hero-wrap-2" style="background-image: url('/images/bg_1.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-start">
            <div class="col-md-9 ftco-animate pb-4">
                <h1 class="mb-3 bread">Appointment</h1>
                <p class="breadcrumbs">
                    <span class="mr-2"><a asp-controller="Home" asp-action="Index">Home <i class="ion-ios-arrow-forward"></i></a></span> 
                    <span>Appointment <i class="ion-ios-arrow-forward"></i></span>
                </p>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section ftco-no-pt ftco-no-pb ftco-services-2 bg-light">
    <div class="container">
        <div class="row d-flex">
            @* Cột bên trái: Giới thiệu dịch vụ *@
            <div class="col-md-7 py-5">
                <div class="py-lg-5">
                    <div class="row justify-content-center pb-5">
                        <div class="col-md-12 heading-section ftco-animate">
                            <h2 class="mb-3">Our Services</h2>
                        </div>
                    </div>
                    <div class="row">
                        @* Giữ lại các block services như cũ của bạn... *@
                        <div class="col-md-6 d-flex align-self-stretch ftco-animate">
                            <div class="media block-6 services d-flex">
                                <div class="icon justify-content-center align-items-center d-flex"><span class="flaticon-ambulance"></span></div>
                                <div class="media-body pl-md-4">
                                    <h3 class="heading mb-3">Emergency Services</h3>
                                    <p>Dịch vụ cấp cứu 24/7 luôn sẵn sàng hỗ trợ bạn.</p>
                                </div>
                            </div>
                        </div>
                        @* (Bạn có thể copy lại các dịch vụ khác từ file cũ vào đây) *@
                    </div>
                </div>
            </div>

            @* Cột bên phải: Form đặt lịch - PHẦN QUAN TRỌNG NHẤT *@
            <div class="col-md-5 d-flex">
                <div class="appointment-wrap bg-white p-5 d-flex align-items-center">
                    <form asp-controller="Home" asp-action="BookAppointment" method="post" class="appointment-form ftco-animate">
                        <h3>Đặt lịch tư vấn</h3>
                        
                        <div class="form-group">
                            <div class="form-field">
                                <div class="select-wrap">
                                    <div class="icon"><span class="ion-ios-arrow-down"></span></div>
                                    @* Dropdown Chuyên khoa *@
                                    <select id="specialtySelect" class="form-control" asp-items="ViewBag.SpecialtyId">
                                        <option value="">-- Chọn Chuyên khoa --</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="form-field">
                                <div class="select-wrap">
                                    <div class="icon"><span class="ion-ios-arrow-down"></span></div>
                                    @* Dropdown Bác sĩ - Sẽ được load động bằng JS *@
                                    <select asp-for="DoctorId" id="doctorSelect" class="form-control">
                                        <option value="">-- Chọn Bác sĩ --</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-wrap">
                                <div class="icon"><span class="ion-md-calendar"></span></div>
                                @* Ngày khám *@
                                <input asp-for="Date" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-wrap">
                                <div class="icon"><span class="ion-ios-clock"></span></div>
                                @* Giờ khám *@
                                <select asp-for="TimeSlot" class="form-control">
                                    <option value="08:00">08:00 AM</option>
                                    <option value="09:00">09:00 AM</option>
                                    <option value="10:00">10:00 AM</option>
                                    <option value="14:00">02:00 PM</option>
                                    <option value="15:00">03:00 PM</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            @* Lý do khám *@
                            <textarea asp-for="Reason" cols="30" rows="3" class="form-control" placeholder="Triệu chứng hoặc lý do khám..."></textarea>
                        </div>

                        <div class="form-group">
                            <input type="submit" value="Xác nhận đặt lịch" class="btn btn-secondary py-3 px-4">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Logic AJAX: Khi chọn chuyên khoa -> Load bác sĩ tương ứng
            $('#specialtySelect').change(function () {
                var specialtyId = $(this).val();
                if (specialtyId) {
                    $.getJSON('/Home/GetDoctorsBySpecialty', { specialtyId: specialtyId }, function (data) {
                        var items = '<option value="">-- Chọn Bác sĩ --</option>';
                        $.each(data, function (i, doctor) {
                            items += "<option value='" + doctor.value + "'>" + doctor.text + "</option>";
                        });
                        $('#doctorSelect').html(items);
                    });
                } else {
                    $('#doctorSelect').html('<option value="">-- Chọn Bác sĩ --</option>');
                }
            });
        });
    </script>
}