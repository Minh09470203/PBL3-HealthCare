﻿@{
    ViewData["Title"] = "SS Medical Center";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Identity
@using PBL3_HealthCare.Models
@using System.Security.Claims
@* @inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager *@
@model PBL3_HealthCare.Models.HomeViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <title>SuperStar Medical Center - Hệ thống phòng khám chuẩn siêu sao</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="css/animate.css">

    <link rel="stylesheet" href="css/owl.carousel.min.css">
    <link rel="stylesheet" href="css/owl.theme.default.min.css">
    <link rel="stylesheet" href="css/magnific-popup.css">

    <link rel="stylesheet" href="css/aos.css">

    <link rel="stylesheet" href="css/ionicons.min.css">

    <link rel="stylesheet" href="css/flaticon.css">
    <link rel="stylesheet" href="css/icomoon.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="py-1 bg-black top">
        <div class="container">
            <div class="row no-gutters d-flex align-items-start align-items-center px-md-0">
                <div class="col-lg-12 d-block">
                    <div class="row d-flex">
                        <div class="col-md pr-4 d-flex topper align-items-center">
                            <div class="icon mr-2 d-flex justify-content-center align-items-center"><span class="icon-phone2"></span></div>
                            <span class="text">+ 1235 2355 98</span>
                        </div>
                        <div class="col-md pr-4 d-flex topper align-items-center">
                            <div class="icon mr-2 d-flex justify-content-center align-items-center"><span class="icon-paper-plane"></span></div>
                            <span class="text">youremail@email.com</span>
                        </div>
                        <div class="col-md-5 pr-4 d-flex topper align-items-center text-lg-right justify-content-end">
                            <div class="mb-0 register-link d-flex align-items-center">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    var userName = User.FindFirstValue(ClaimTypes.Name) ?? User.Identity.Name;
                                    <a asp-controller="Home" asp-action="Profile" class="mr-3 text-white text-decoration-none">
                                        Xin chào @User.Identity.Name
                                    </a>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-white p-0 border-0">Đăng xuất</button>
                                    </form>
                                }
                                else
                                {
                                    <a href="/Identity/Account/Register" class="mr-3 text-white">Đăng ký</a>
                                    <a href="/Identity/Account/Login" class="text-white">Đăng nhập</a>
                                }
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light site-navbar-target" id="ftco-navbar">
        <div class="container">
            <a class="navbar-brand" href="index.html">SUPERSTAR</a>
            <button class="navbar-toggler js-fh5co-nav-toggle fh5co-nav-toggle" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="oi oi-menu"></span> Menu
            </button>

            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav nav ml-auto">
                    <li class="nav-item"><a href="#home-section" class="nav-link"><span>Trang chủ</span></a></li>
                    <li class="nav-item"><a href="#about-section" class="nav-link"><span>Giới thiệu</span></a></li>
                    <li class="nav-item"><a href="#department-section" class="nav-link"><span>Khoa</span></a></li>
                    <li class="nav-item"><a href="#doctor-section" class="nav-link"><span>Bác sĩ</span></a></li>
                    <li class="nav-item"><a href="#contact-section" class="nav-link"><span>Liên hệ</span></a></li>
                    <li class="nav-item cta mr-md-2"><a asp-controller="Home" asp-action="BookAppointment" class="nav-link">Đặt lịch khám</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="hero-wrap js-fullheight" style="background-image: url('/img/bg_3.jpg');" data-section="home" data-stellar-background-ratio="0.5">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text js-fullheight align-items-center justify-content-start" data-scrollax-parent="true">
                <div class="col-md-6 pt-5 ftco-animate">
                    <div class="mt-5">
                        <span class="subheading">Chào mừng đến với SuperStar Medical Center</span>
                        <h1 class="mb-4">Chúng tôi luôn ở đây <br>để chăm sóc sức khỏe của bạn</h1>
                        <p class="mb-4">Far far away, behind the word mountains, far from the countries Vokalia and Consonantia, there live the blind texts. Separated they live in Bookmarksgrove.</p>
                        <p><a asp-controller="Home" asp-action="BookAppointment" class="btn btn-primary py-3 px-4">Đặt lịch khám</a></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="ftco-counter img ftco-section ftco-no-pt ftco-no-pb" id="about-section">
        <div class="container">
            <div class="row d-flex">
                <div class="col-md-6 col-lg-5 d-flex">
                    <div class="img d-flex align-self-stretch align-items-center" style="background-image: url('/img/about.jpg');">
                    </div>
                </div>
                <div class="col-md-6 col-lg-7 pl-lg-5 py-md-5">
                    <div class="py-md-5">
                        <div class="row justify-content-start pb-3">
                            <div class="col-md-12 heading-section ftco-animate p-4 p-lg-5">
                                <h2 class="mb-4">Chúng tôi là <span>Mediplus</span> siêu sao</h2>
                                <p>Hãy tự tin đến khám tại phòng của chúng tôi.</p>
                                <p><a href="#about-section" class="btn btn-primary py-3 px-4">Đặt lịch khám</a> <a href="#" class="btn btn-secondary py-3 px-4">Contact us</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="ftco-section ftco-no-pt ftco-no-pb ftco-services-2 bg-light">
        <div class="container">
            <div class="row d-flex">
                <div class="col-md-7 py-5">
                    <div class="py-lg-5">
                        <div class="row justify-content-center pb-5">
                            <div class="col-md-12 heading-section ftco-animate">
                                <h2 class="mb-3">Dịch vụ của chúng tôi</h2>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 d-flex align-self-stretch ftco-animate">
                                <div class="media block-6 services d-flex">
                                    <div class="icon justify-content-center align-items-center d-flex"><span class="flaticon-ambulance"></span></div>
                                    <div class="media-body pl-md-4">
                                        <h3 class="heading mb-3">Dịch vụ cấp cứu</h3>
                                        <p>Luôn sẵn sàng hỗ trợ trong mọi tình huống khẩn cấp 24/7.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-self-stretch ftco-animate">
                                <div class="media block-6 services d-flex">
                                    <div class="icon justify-content-center align-items-center d-flex"><span class="flaticon-doctor"></span></div>
                                    <div class="media-body pl-md-4">
                                        <h3 class="heading mb-3">Bác sĩ chuyên môn cao</h3>
                                        <p>Đội ngũ y bác sĩ giàu kinh nghiệm, tận tâm với bệnh nhân.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-self-stretch ftco-animate">
                                <div class="media block-6 services d-flex">
                                    <div class="icon justify-content-center align-items-center d-flex"><span class="flaticon-stethoscope"></span></div>
                                    <div class="media-body pl-md-4">
                                        <h3 class="heading mb-3">Khám bệnh ngoại trú</h3>
                                        <p>Quy trình khám chữa bệnh nhanh chóng, hiệu quả.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-self-stretch ftco-animate">
                                <div class="media block-6 services d-flex">
                                    <div class="icon justify-content-center align-items-center d-flex"><span class="flaticon-24-hours"></span></div>
                                    <div class="media-body pl-md-4">
                                        <h3 class="heading mb-3">Dịch vụ 24 giờ</h3>
                                        <p>Hệ thống hỗ trợ trực tuyến và trực tiếp mọi lúc mọi nơi.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <section class="ftco-section ftco-no-pt ftco-no-pb" id="department-section">
        <div class="container-fluid px-0">
            <div class="row no-gutters">
                <div class="col-md-4 d-flex">
                    <div class="img img-dept align-self-stretch" style="background-image: url('/img/dept-1.jpg');"></div>
                </div>

                <div class="col-md-8">
                    <div class="row no-gutters">
                        @if (ViewBag.TopSpecialties != null)
                        {
                            foreach (var khoa in ViewBag.TopSpecialties)
                            {
                                <div class="col-md-4 d-flex">
                                    <div class="department-wrap p-4 ftco-animate align-self-stretch w-100">
                                        <div class="text p-2 text-center">
                                            <div class="icon">
                                                <span class="flaticon-stethoscope"></span>
                                            </div>
                                            <h3><a asp-controller="Home" asp-action="DoctorList" asp-route-specialtyId="@khoa.Id">@khoa.Name</a></h3>
                                            <p>Khám và điều trị chuyên sâu các bệnh lý thuộc chuyên khoa @khoa.Name.</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 p-5 text-center">
                                <p class="text-muted">Đang cập nhật danh sách chuyên khoa...</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="ftco-section" id="doctor-section">
        <div class="container-fluid px-5">
            <div class="row justify-content-center mb-5 pb-2">
                <div class="col-md-8 text-center heading-section ftco-animate">
                    <h2 class="mb-4">Những bác sĩ hàng đầu của chúng tôi</h2>
                    <p>Đội ngũ bác sĩ giàu kinh nghiệm, chuyên môn cao và luôn tận tâm trong việc chăm sóc sức khỏe cho bệnh nhân. Chúng tôi cam kết mang đến dịch vụ khám chữa bệnh chất lượng và an toàn.</p>
                </div>
            </div>
            <div class="row">
                @if (Model?.TopDoctors != null && Model.TopDoctors.Any())
                {
                    foreach (var doctor in Model.TopDoctors)
                    {
                        <div class="col-md-6 col-lg-3 ftco-animate">
                            <div class="staff">
                                <div class="img-wrap d-flex align-items-stretch">
                                    @* Sử dụng ảnh từ database, nếu không có thì dùng ảnh mặc định *@
                                    <div class="img align-self-stretch" style="background-image: url(/images/doctors/@(doctor.Image ?? "default.jpg"));"></div>
                                </div>
                                <div class="text pt-3 text-center">
                                    <h3 class="mb-2">@(doctor.User?.FullName ?? "Bác sĩ")</h3>
                                    <span class="position mb-2">@(doctor.Specialty?.Name ?? "Chuyên khoa")</span>
                                    <div class="faded">
                                        <p>Tận tâm - Chuyên nghiệp - Chất lượng cao.</p>
                                        <ul class="ftco-social text-center">
                                            <li class="ftco-animate"><a href="#"><span class="icon-twitter"></span></a></li>
                                            <li class="ftco-animate"><a href="#"><span class="icon-facebook"></span></a></li>
                                            <li class="ftco-animate"><a href="#"><span class="icon-google-plus"></span></a></li>
                                            <li class="ftco-animate"><a href="#"><span class="icon-instagram"></span></a></li>
                                        </ul>
                                        <p><a asp-controller="Home" asp-action="DoctorProfile" asp-route-id="@doctor.Id" class="btn btn-primary">Đặt lịch ngay</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-md-12 text-center">
                        <p>Hiện đang cập nhật danh sách bác sĩ tiêu biểu...</p>
                    </div>
                }
            </div>
        </div>
    </section>
    

    <section class="ftco-section contact-section" id="contact-section">
        <div class="container">
            <div class="row justify-content-center mb-5 pb-3">
                <div class="col-md-7 heading-section text-center ftco-animate">
                    <h2 class="mb-4">Liên hệ với chúng tôi</h2>
                    <p>Nếu bạn có bất kỳ thắc mắc nào về dịch vụ y tế hoặc muốn đặt lịch khám, vui lòng liên hệ với chúng tôi. Đội ngũ của chúng tôi luôn sẵn sàng hỗ trợ và tư vấn cho bạn.</p>
                </div>
            </div>
            <div class="row d-flex contact-info mb-5">
                <div class="col-md-6 col-lg-3 d-flex ftco-animate">
                    <div class="align-self-stretch box p-4 text-center bg-light">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="icon-map-signs"></span>
                        </div>
                        <h3 class="mb-4">Địa chỉ</h3>
                        <p>120 Yên Lãng</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 d-flex ftco-animate">
                    <div class="align-self-stretch box p-4 text-center bg-light">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="icon-phone2"></span>
                        </div>
                        <h3 class="mb-4">Số điện thoại</h3>
                        <p><a href="tel://1234567920">+ 1235 2355 98</a></p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 d-flex ftco-animate">
                    <div class="align-self-stretch box p-4 text-center bg-light">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="icon-paper-plane"></span>
                        </div>
                        <h3 class="mb-4">Địa chỉ email</h3>
                        <p><a href="mailto:info@yoursite.com">info@yoursite.com</a></p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 d-flex ftco-animate">
                    <div class="align-self-stretch box p-4 text-center bg-light">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="icon-globe"></span>
                        </div>
                        <h3 class="mb-4">Website</h3>
                        <p><a href="#">yoursite.com</a></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="ftco-footer ftco-section img" style="background-image: url('/img/footer-bg.jpg');">
        <div class="overlay"></div>
        <div class="container-fluid px-md-5">
            <div class="row mb-5">
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">SuperStar</h2>
                        <p>Tôn trọng, cổ điển.</p>
                        <ul class="ftco-footer-social list-unstyled mt-5">
                            <li class="ftco-animate"><a href="#"><span class="icon-twitter"></span></a></li>
                            <li class="ftco-animate"><a href="#"><span class="icon-facebook"></span></a></li>
                            <li class="ftco-animate"><a href="#"><span class="icon-instagram"></span></a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4 ml-md-4">
                        <h2 class="ftco-heading-2">Khoa</h2>
                        <ul class="list-unstyled">
                            <li><span class="icon-long-arrow-right mr-2"></span>Thần kinh</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Nha khoa</a></li>
                            <li><<span class="icon-long-arrow-right mr-2"></span>Chụp MRI</></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Ngoại khoa</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Tim mạch</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Nha khoa</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4 ml-md-4">
                        <h2 class="ftco-heading-2">Links</h2>
                        <ul class="list-unstyled">
                            <li><span class="icon-long-arrow-right mr-2"></span>Trang chủ</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Giới thiệu</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Khoa</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Bác sĩ</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Liên hệ</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Dịch vụ</h2>
                        <ul class="list-unstyled">
                            <li><span class="icon-long-arrow-right mr-2"></span>Dịch vụ cấp cứu</a></li>
                            <li><span class="icon-long-arrow-right mr-2"></span>Bác sĩ chuyên môn cao</a></li>
                            <li><<span class="icon-long-arrow-right mr-2"></span>Khám bệnh ngoại trú</></li>
                            <li><<span class="icon-long-arrow-right mr-2"></span>Dịch vụ 24 giờ</></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Thắc mắc?</h2>
                        <div class="block-23 mb-3">
                            <ul>
                                <li><span class="icon icon-map-marker"></span><span class="text">120 An Liễng</span></li>
                                <li><span class="icon icon-phone"></span><span class="text">+2 392 3929 210</span></a></li>
                                <li><<span class="icon icon-envelope pr-4"></span><span class="text">info@yourdomain.com</span></></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-center">

                    <p>
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                        Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | PBL3 Health Care <i class="icon-heart color-danger" aria-hidden="true"></i> by 4thangdaucac</a>
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    </p>
                </div>
            </div>
        </div>
    </footer>



    <!-- loader -->
    <div id="ftco-loader" class="show fullscreen"><svg class="circular" width="48px" height="48px"><circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee" /><circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00" /></svg></div>


    <script src="js/jquery.min.js"></script>
    <script src="js/jquery-migrate-3.0.1.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/jquery.easing.1.3.js"></script>
    <script src="js/jquery.waypoints.min.js"></script>
    <script src="js/jquery.stellar.min.js"></script>
    <script src="js/owl.carousel.min.js"></script>
    <script src="js/jquery.magnific-popup.min.js"></script>
    <script src="js/aos.js"></script>
    <script src="js/jquery.animateNumber.min.js"></script>
    <script src="js/scrollax.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBVWaKrjvy3MaE7SQ74_uJiULgl1JY0H2s&sensor=false"></script>
    <script src="js/google-map.js"></script>

    <script src="js/main.js"></script>

   
</body>
</html>