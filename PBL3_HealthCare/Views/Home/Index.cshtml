    @{
        ViewData["Title"] = "SS Medical Center";
        Layout = "~/Views/Shared/_HomeLayout.cshtml";
    }
    @using Microsoft.AspNetCore.Identity
    @using PBL3_HealthCare.Models
    @using System.Security.Claims
    @model PBL3_HealthCare.ViewModels.HomeViewModel

    @section Styles {
        <link rel="stylesheet" href="~/css/home/home.css" />
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        /* 1. Nâng cấp Card Dịch vụ */
        .service-card {
            border-radius: 20px;
            background: #ffffff;
            border: 1px solid #f4f6f9;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
            text-align: center;
            padding: 20px 10px;
            height: 190px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-decoration: none;
            color: #2b3452;
            position: relative;
            overflow: hidden;
        }

            .service-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(61, 94, 225, 0.1);
                color: #3d5ee1;
            }

            .service-card::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, #3d5ee1, #00d2ff);
                transform: scaleX(0);
                transition: transform 0.3s ease;
                transform-origin: left;
            }

            .service-card:hover::after {
                transform: scaleX(1);
            }

        .badge-hot {
            position: absolute;
            top: 12px;
            right: 12px;
            font-size: 11px;
            border-radius: 8px;
        }

        /* 2. Nút bấm Mũi tên */
        .swiper-button-next, .swiper-button-prev {
            background-color: #ffffff;
            width: 45px !important;
            height: 45px !important;
            border-radius: 50%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            color: #3d5ee1 !important;
            margin-top: -22px;
            z-index: 10;
        }

            .swiper-button-next:after, .swiper-button-prev:after {
                font-size: 16px !important;
                font-weight: 900;
            }

        .swiper-button-prev {
            left: -5px !important;
        }

        .swiper-button-next {
            right: -5px !important;
        }
    </style>

    <section class="hero-wrap js-fullheight"
             style="background-image:url('/img/bg_3.jpg');"
             data-section="home" data-stellar-background-ratio="0.5"
             id="home-section">
        <div class="overlay"></div>
        <div class="container h-100">
            <div class="row slider-text js-fullheight align-items-center">
                <div class="col-md-6 pt-5">
                    <div class="mt-5 fade-up">
                        <span class="subheading">Chào mừng đến với SuperStar Medical Center</span>
                        <h1 class="mb-4">Chúng tôi luôn ở đây<br>để chăm sóc<br>sức khỏe của bạn</h1>
                        <p class="mb-4">Đội ngũ y bác sĩ chuyên nghiệp, trang thiết bị hiện đại và dịch vụ tận tâm — chúng tôi cam kết mang đến trải nghiệm khám chữa bệnh tốt nhất.</p>
                        <a asp-controller="Home" asp-action="BookAppointment" class="btn btn-primary py-3 px-4">Đặt lịch khám ngay →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="stats-strip">
        <div class="container">
            <div class="row text-center">
                <div class="col-6 col-md-3 stat-item fade-up">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Bác sĩ chuyên khoa</div>
                </div>
                <div class="col-6 col-md-3 stat-item stat-divider fade-up delay-1">
                    <div class="stat-number">12</div>
                    <div class="stat-label">Chuyên khoa</div>
                </div>
                <div class="col-6 col-md-3 stat-item stat-divider fade-up delay-2">
                    <div class="stat-number">10K+</div>
                    <div class="stat-label">Bệnh nhân tin tưởng</div>
                </div>
                <div class="col-6 col-md-3 stat-item stat-divider fade-up delay-3">
                    <div class="stat-number">24/7</div>
                    <div class="stat-label">Hỗ trợ liên tục</div>
                </div>
            </div>
        </div>
    </div>

    <section style="background-color: #f8f9fc; padding-top: 50px; padding-bottom: 50px;">
        <div class="container mt-5">
            <h3 class="text-center font-weight-bold text-primary mb-4">Dịch vụ Y tế Toàn diện</h3>

            <div class="swiper mySwiper" style="padding: 20px 50px;">
                <div class="swiper-wrapper py-3">

                    <div class="swiper-slide">
                        <a asp-controller="Home" asp-action="DoctorList" class="service-card">
                            <img src="~/img/cards/medical-team.png" alt="Đặt khám Bác sĩ"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(61, 94, 225, 0.15);" />
                            <h6 class="font-weight-bold">Đặt khám Bác sĩ</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a asp-controller="Home" asp-action="SpecialtyList" class="service-card">
                            <img src="~/img/cards/medical.png" alt="Khám Chuyên khoa"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(255, 152, 0, 0.15);" />
                            <h6 class="font-weight-bold">Khám Chuyên khoa</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a asp-controller="Home" asp-action="BookAppointment" asp-route-type="video" class="service-card">
                            <span class="badge bg-success text-white badge-hot">Sẵn sàng</span>
                            <img src="~/img/cards/telemedicine.png" alt="Khám qua Video"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(156, 39, 176, 0.15);" />
                            <h6 class="font-weight-bold">Khám qua Video</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a asp-controller="Services" asp-action="Packages" class="service-card">
                            <img src="~/img/cards/insurance.png" alt="Gói khám Sức khỏe"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(0, 210, 255, 0.15);" />
                            <h6 class="font-weight-bold">Gói khám Sức khỏe</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a asp-controller="Services" asp-action="Vaccines" class="service-card">
                            <img src="~/img/cards/syringe.png" alt="Đặt Lịch Tiêm Chủng"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(233, 30, 99, 0.15);" />
                            <h6 class="font-weight-bold">Đặt Lịch Tiêm Chủng</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a asp-controller="Services" asp-action="HomeCare" class="service-card">
                            <img src="~/img/cards/house-cleaning.png" alt="Y Tế Tại Nhà"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(32, 201, 151, 0.15);" />
                            <h6 class="font-weight-bold">Y Tế Tại Nhà</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a href="https://www.nhathuocankhang.com/" target="_blank" rel="noopener noreferrer" class="service-card">
                            <span class="badge bg-danger text-white badge-hot">Hot</span>
                            <img src="~/img/cards/images.png" alt="Nhà thuốc Online"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(0, 175, 82, 0.15);" />
                            <h6 class="font-weight-bold">Nhà thuốc An Khang</h6>
                        </a>
                    </div>

                    <div class="swiper-slide">
                        <a href="#" class="service-card" onclick="document.body.classList.add('show-chatbot'); return false;">
                            <span class="badge bg-info text-white badge-hot">AI</span>
                            <img src="~/img/cards/ai.png" alt="Trợ lý Y tế AI"
                                 style="height: 65px; width: 65px; margin-bottom: 15px; object-fit: cover; border-radius: 14px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);" />
                            <h6 class="font-weight-bold">Trợ lý Y tế AI</h6>
                        </a>
                    </div>

                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    </section>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        <script>
            // Animation Fade Up
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        e.target.classList.add('visible');
                        observer.unobserve(e.target);
                    }
                });
            }, { threshold: 0.12 });
            document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

            // Swiper Initialization
            var swiper = new Swiper(".mySwiper", {
                slidesPerView: 1,
                spaceBetween: 20,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                breakpoints: {
                    640: { slidesPerView: 2, spaceBetween: 20 },
                    768: { slidesPerView: 3, spaceBetween: 30 },
                    1024: { slidesPerView: 4, spaceBetween: 30 },
                },
            });
        </script>
    }