@model IEnumerable<PBL3_HealthCare.Models.Doctor>
@{
    ViewData["Title"] = ViewBag.SpecialtyName != null ? "Khoa " + ViewBag.SpecialtyName : "Danh sách Bác sĩ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/doctor-list.css" />
    @* Mọi mã CSS lằng nhằng đã được tui dọn dẹp đưa hết vào file CSS bên trên rồi sếp nhé! *@
}

<section class="doctors-section">
    <div class="container">

        @* Specialty hero banner *@
        @if (ViewBag.SpecialtyName != null)
        {
            <div class="specialty-hero">
                <div class="row g-0">
                    <div class="col-md-6 d-flex flex-column justify-content-center">
                        <div class="specialty-hero-text">
                            <p class="section-eyebrow">Giới thiệu chuyên khoa</p>
                            <h1 class="specialty-hero-title">Khoa <span>@ViewBag.SpecialtyName</span></h1>
                            <p class="specialty-hero-desc">
                                @(ViewBag.SpecialtyDescription ?? "Phòng khám chúng tôi cung cấp các dịch vụ chăm sóc sức khỏe tốt nhất với trang thiết bị hiện đại và đội ngũ y bác sĩ tận tâm.")
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="specialty-hero-img-wrap">
                            @{
                                string specImage = ViewBag.SpecialtyImage as string;
                                string imgSrc = "/img/specialties/default-specialty.jpg";
                                if (!string.IsNullOrWhiteSpace(specImage))
                                {
                                    imgSrc = specImage.StartsWith("/") ? specImage : "/img/specialties/" + specImage;
                                }
                            }
                            <img src="@imgSrc"
                                 alt="Khoa @ViewBag.SpecialtyName"
                                 onerror="this.onerror=null; this.src='/img/specialties/default-specialty.jpg';" />
                        </div>
                    </div>
                </div>
            </div>
        }

        <p class="section-eyebrow">Đội ngũ y tế</p>
        <h2 class="section-heading d-flex align-items-center">
            @if (ViewBag.SpecialtyName != null)
            {
                <span>Bác sĩ chuyên khoa @ViewBag.SpecialtyName</span>
            }
            else
            {
                @:Tất cả <span>Bác sĩ</span>
            }
        </h2>

        @* 🔥 KHU VỰC THÔNG BÁO HOẶC GỢI Ý ĐIỀU HƯỚNG 🔥 *@
        @if (ViewBag.IsVideoCall == true)
        {
            <div class="alert-video-call">
                <i class="fas fa-laptop-medical"></i>
                <div>
                    <strong>Chế độ Khám Trực Tuyến:</strong> Bạn đang chọn bác sĩ để tư vấn sức khỏe qua Video Call. Đội ngũ bác sĩ của chúng tôi luôn sẵn sàng hỗ trợ bạn từ xa.
                </div>
            </div>
        }
        else
        {
            @* Banner gọi ý khi khách đang ở giao diện khám thường *@
            <div class="promo-video-call d-flex flex-wrap align-items-center justify-content-between">
                <div class="d-flex align-items-center mb-3 mb-md-0">
                    <div class="promo-icon-box pulse-animation">
                        <!-- Mã SVG vẽ icon máy quay đảm bảo hiển thị 100% -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M0 5a2 2 0 0 1 2-2h7.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 4.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 13H2a2 2 0 0 1-2-2V5z" />
                        </svg>
                    </div>
                    <div class="promo-text ms-3">
                        <h5 class="mb-1 fw-bold text-dark d-flex align-items-center">
                            Khám Online ngay tại nhà! <span class="badge bg-danger ms-2" style="font-size: 0.7rem;">Mới</span>
                        </h5>
                        <p class="mb-0 text-muted" style="font-size: 0.95rem;">Bạn không tiện đi xa? Hãy thử kết nối qua Video Call với bác sĩ chuyên khoa.</p>
                    </div>
                </div>
                <button onclick="switchToVideoCall()" class="btn btn-outline-primary-custom rounded-pill fw-bold px-4 py-2">
                    Chuyển sang Khám Video &rarr;
                </button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-6">
                        <div class="doctor-card">

                            @* 🔥 BADGE MỚI: Nằm ở góc phải trên cùng của Card trắng, KHÔNG che ảnh 🔥 *@
                            @if (ViewBag.IsVideoCall == true)
                            {
                                <div class="video-status-badge">
                                    <span class="status-dot"></span> Sẵn sàng Video
                                </div>
                            }

                            @* Ảnh bên trái *@
                            <div class="photo-wrap">
                                <img src="@ImageHelper.GetImageUrl(item.Image, "/img/doctors/default.jpg")"
                                     alt="@item.User?.FullName"
                                     onerror="this.src='/img/doctors/default.jpg'" />
                                <span class="specialty-tag">@(item.Specialty?.Name ?? "Chuyên khoa")</span>
                            </div>

                            @* Thông tin bên phải *@
                            <div class="card-content">
                                <div class="doctor-name">BS. @(item.User?.FullName ?? "Đang cập nhật")</div>
                                <div class="doctor-degree">@(item.Degree ?? "")</div>

                                <div class="info-row">
                                    <span class="info-label">Chuyên khoa:</span>
                                    <span class="info-val">@(item.Specialty?.Name ?? "—")</span>
                                </div>

                                <div class="card-footer-row">
                                    <div>
                                        <div class="price-label">Giá khám</div>
                                        <div class="price-value">@string.Format("{0:N0}", item.Price)đ</div>
                                    </div>

                                    <a asp-controller="Home" asp-action="DoctorInfo"
                                       asp-route-id="@item.Id"
                                       asp-route-isVideoCall="@(ViewBag.IsVideoCall == true ? "true" : "false")"
                                       class="btn-book @(ViewBag.IsVideoCall == true ? "btn-video" : "")">
                                        @(ViewBag.IsVideoCall == true ? "Tư vấn Video →" : "Đặt hẹn →")
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-user-md"></i></div>
                <p>Chưa có bác sĩ nào thuộc chuyên khoa này.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-back">Quay lại trang chủ</a>
            </div>
        }

    </div>
</section>

@section Scripts {
    <script>
        // Hàm thông minh giúp chuyển đổi sang chế độ Video Call giữ nguyên bộ lọc
        function switchToVideoCall() {
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('isVideoCall', 'true');
            window.location.search = urlParams.toString();
        }
    </script>
}