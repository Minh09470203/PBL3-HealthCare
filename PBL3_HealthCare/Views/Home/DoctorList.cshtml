@model IEnumerable<PBL3_HealthCare.Models.Doctor>
@{
    ViewData["Title"] = "Danh sách Bác sĩ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/doctor-list.css" />
}

<section class="doctors-section">
    <div class="container">
        <p class="section-eyebrow">Đội ngũ y tế</p>
        <h2 class="section-heading">
            @if (ViewBag.SpecialtyName != null)
            {
                <span>Khoa @ViewBag.SpecialtyName</span>
            }
            else
            {
                @:Tất cả <span>Bác sĩ</span>
            }
        </h2>

        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6 mb-4">
                        <div class="doctor-card">
                            <div class="photo-wrap">
                                <img src="/img/doctors/@(item.Image ?? "default.jpg")"
                                     alt="@item.User?.FullName"
                                     onerror="this.src='/img/doctors/default.jpg'" />
                                <span class="specialty-tag">@(item.Specialty?.Name ?? "Chuyên khoa")</span>
                            </div>
                            <div class="card-content">
                                <div class="doctor-name">BS. @(item.User?.FullName ?? "Đang cập nhật")</div>
                                <div class="doctor-degree">@(item.Degree ?? "")</div>
                                <div class="price-row">
                                    <span class="price-label">Giá khám</span>
                                    <span class="price-value">@string.Format("{0:N0}", item.Price)đ</span>
                                </div>
                                <a asp-controller="Home" asp-action="DoctorInfo" asp-route-id="@item.Id"
                                   class="btn-book">Xem lịch &amp; Đặt hẹn →</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-user-md"></i></div>
                <p>Chưa có bác sĩ nào thuộc chuyên khoa này.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-back">Quay lại trang chủ</a>
            </div>
        }
    </div>
</section>
