@model IEnumerable<PBL3_HealthCare.Models.Doctor>
@{
    ViewData["Title"] = ViewBag.SpecialtyName != null ? "Khoa " + ViewBag.SpecialtyName : "Danh sách Bác sĩ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/doctor-list.css" />
}

<section class="doctors-section">
    <div class="container">

        @* Specialty hero banner *@
        @if (ViewBag.SpecialtyName != null)
        {
            <div class="specialty-hero">
                <div class="row g-0">
                    <div class="col-md-6 d-flex flex-column justify-content-center">
                        <div class="specialty-hero-text">
                            <p class="section-eyebrow">Giới thiệu chuyên khoa</p>
                            <h1 class="specialty-hero-title">Khoa <span>@ViewBag.SpecialtyName</span></h1>
                            <p class="specialty-hero-desc">
                                @(ViewBag.SpecialtyDescription ?? "Phòng khám chúng tôi cung cấp các dịch vụ chăm sóc sức khỏe tốt nhất với trang thiết bị hiện đại và đội ngũ y bác sĩ tận tâm.")
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="specialty-hero-img-wrap">
                            @{
                                string specImage = ViewBag.SpecialtyImage as string;
                                string imgSrc = "/img/specialties/default-specialty.jpg";
                                if (!string.IsNullOrWhiteSpace(specImage))
                                {
                                    imgSrc = specImage.StartsWith("/") ? specImage : "/img/specialties/" + specImage;
                                }
                            }
                            <img src="@imgSrc"
                                 alt="Khoa @ViewBag.SpecialtyName"
                                 onerror="this.onerror=null; this.src='/img/specialties/default-specialty.jpg';" />
                        </div>
                    </div>
                </div>
            </div>
        }

        <p class="section-eyebrow">Đội ngũ y tế</p>
        <h2 class="section-heading">
            @if (ViewBag.SpecialtyName != null)
            {
                <span>Bác sĩ chuyên khoa @ViewBag.SpecialtyName</span>
            }
            else
            {
                @:Tất cả <span>Bác sĩ</span>
            }
        </h2>

        @if (Model != null && Model.Any())
        {
            @* Layout ngang kiểu Medpro — mỗi card chiếm 1 hàng *@
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-6">
                        <div class="doctor-card">

                            @* Ảnh bên trái *@
                            <div class="photo-wrap">
                                <img src="/img/doctors/@(item.Image ?? "default.jpg")"
                                     alt="@item.User?.FullName"
                                     onerror="this.src='/img/doctors/default.jpg'" />
                                <span class="specialty-tag">@(item.Specialty?.Name ?? "Chuyên khoa")</span>
                            </div>

                            @* Thông tin bên phải *@
                            <div class="card-content">
                                <div class="doctor-name">BS. @(item.User?.FullName ?? "Đang cập nhật")</div>
                                <div class="doctor-degree">@(item.Degree ?? "")</div>

                                <div class="info-row">
                                    <span class="info-label">Chuyên khoa:</span>
                                    <span class="info-val">@(item.Specialty?.Name ?? "—")</span>
                                </div>

                                @* ĐÃ XÓA PHẦN INFO-ROW CỦA "GIÁ KHÁM" Ở ĐÂY CHO GỌN *@

                                <div class="card-footer-row">
                                    <div>
                                        <div class="price-label">Giá khám</div>
                                        <div class="price-value">@string.Format("{0:N0}", item.Price)đ</div>
                                    </div>
                                    <a asp-controller="Home" asp-action="DoctorInfo"
                                       asp-route-id="@item.Id"
                                       asp-route-isVideoCall="@(ViewBag.IsVideoCall == true ? "true" : "false")"
                                       class="btn-book">Đặt hẹn →</a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-user-md"></i></div>
                <p>Chưa có bác sĩ nào thuộc chuyên khoa này.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-back">Quay lại trang chủ</a>
            </div>
        }

    </div>
</section>