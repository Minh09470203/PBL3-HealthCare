@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-key text-primary mr-2"></i>Đổi mật khẩu</h1>
    <a asp-action="Profile" class="d-none d-sm-inline-block btn btn-sm btn-light shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-gray-500 mr-1"></i> Quay lại Hồ sơ
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cập nhật mật khẩu mới</h6>
            </div>
            <div class="card-body p-4">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle mr-1"></i> @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-4">
                        <label class="font-weight-bold text-dark">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <input type="password" name="oldPassword" class="form-control" required placeholder="Nhập mật khẩu đang sử dụng">
                    </div>

                    <div class="form-group mb-4">
                        <label class="font-weight-bold text-dark">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" name="newPassword" class="form-control" required placeholder="Nhập mật khẩu mới">
                        <small class="form-text text-muted">Mật khẩu phải có ít nhất 6 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
                    </div>

                    <div class="form-group mb-5">
                        <label class="font-weight-bold text-dark">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" name="confirmPassword" class="form-control" required placeholder="Nhập lại mật khẩu mới">
                    </div>

                    <button type="submit" class="btn btn-primary btn-block py-2 shadow-sm font-weight-bold">
                        <i class="fas fa-check-circle mr-1"></i> Lưu mật khẩu mới
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>