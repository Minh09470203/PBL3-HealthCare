@model PBL3_HealthCare.Models.Specialty

@{
    ViewData["Title"] = "Chi tiết Chuyên khoa";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/specialties.css" />
}

<a asp-action="Index" class="btn btn-light btn-sm mb-3" style="border-radius:8px;"><i class="fas fa-arrow-left mr-1"></i>Quay lại danh sách</a>

<div class="detail-card card mb-4" style="max-width:640px;">
    <div class="specialty-hero">
        <div class="specialty-hero-icon"><i class="fas fa-stethoscope"></i></div>
        <h4>@Model?.Name</h4>
        <span class="id-pill"><i class="fas fa-fingerprint mr-1"></i>#@Model?.Id</span>
    </div>

    <div class="detail-body">
        @if (!string.IsNullOrEmpty(Model?.Image))
        {
            <div class="specialty-image-preview">
                <img src="@ImageHelper.GetImageUrl(Model.Image)" alt="@Model.Name" onerror="this.parentElement.style.display='none'" />
            </div>
        }

        <div class="info-item">
            <div class="info-label"><i class="fas fa-stethoscope mr-1"></i>Tên chuyên khoa</div>
            <div class="info-value">@Model?.Name</div>
        </div>

        <div class="info-item yellow">
            <div class="info-label"><i class="fas fa-align-left mr-1"></i>Mô tả</div>
            <div class="info-value @(string.IsNullOrWhiteSpace(Model?.Description) ? "muted" : "")">
                @(string.IsNullOrWhiteSpace(Model?.Description) ? "Chưa có mô tả" : Model.Description)
            </div>
        </div>

        <div class="info-item teal">
            <div class="info-label"><i class="fas fa-image mr-1"></i>Đường dẫn hình ảnh</div>
            <div class="info-value @(string.IsNullOrWhiteSpace(Model?.Image) ? "muted" : "")" style="font-size:.82rem;word-break:break-all;">
                @(string.IsNullOrWhiteSpace(Model?.Image) ? "Chưa có ảnh" : Model.Image)
            </div>
        </div>
    </div>

    <div class="action-bar">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-edit-action"><i class="fas fa-edit mr-1"></i>Chỉnh sửa</a>
        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-delete-action"><i class="fas fa-trash mr-1"></i>Xóa</a>
        <a asp-action="Index" class="btn btn-back-action ml-auto"><i class="fas fa-list mr-1"></i>Danh sách</a>
    </div>
</div>
