@model PBL3_HealthCare.Models.Specialty

@{
    ViewData["Title"] = "Chỉnh sửa Chuyên khoa";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/specialties.css" />
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-light btn-sm mr-3" style="border-radius:8px;"><i class="fas fa-arrow-left mr-1"></i>Quay lại</a>
    <span class="id-badge"><i class="fas fa-fingerprint mr-1"></i>ID: @Model?.Id</span>
</div>

<div class="form-card edit card mb-4" style="max-width:720px;">
    <div class="card-header">
        <h5><i class="fas fa-edit mr-2"></i>Chỉnh sửa Chuyên khoa</h5>
        <p>Cập nhật thông tin — @Model?.Name</p>
    </div>
    <div class="card-body">
        <form asp-action="Edit" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="border-radius:10px;font-size:.85rem;"></div>
            <input type="hidden" asp-for="Id" />

            <p class="form-section-title yellow"><i class="fas fa-info-circle mr-1"></i>Thông tin chuyên khoa</p>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Tên chuyên khoa</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-stethoscope"></i>
                            <input asp-for="Name" class="form-control" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating-custom">
                        <label>Đường dẫn hình ảnh</label>
                        <div class="input-icon-wrap">
                            <i class="input-icon fas fa-link"></i>
                            <input asp-for="Image" class="form-control" id="imageInput" />
                        </div>
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>
                    <div class="image-preview-box" id="imagePreview">
                        @if (!string.IsNullOrEmpty(Model?.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Name" onerror="this.parentElement.innerHTML='<div class=no-image><i class=fas fa-image></i></div><p>Không tải được ảnh</p>'" />
                        }
                        else
                        {
                            <div class="no-image"><i class="fas fa-image"></i></div>
                            <p>Nhập URL để xem trước ảnh</p>
                        }
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-floating-custom">
                        <label>Mô tả chuyên khoa</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <hr style="border-color:#fff8e0;margin:1.5rem 0;">
            <div class="d-flex" style="gap:.75rem">
                <button type="submit" class="btn btn-save-yellow"><i class="fas fa-save mr-1"></i>Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-cancel-soft"><i class="fas fa-times mr-1"></i>Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('imageInput').addEventListener('input', function () {
            var url = this.value.trim();
            var box = document.getElementById('imagePreview');
            if (url) {
                box.innerHTML = '<img src="' + url + '" alt="Preview" onerror="this.parentElement.innerHTML=\'<div class=no-image><i class=fas\\ fa-image></i></div><p>Không tải được ảnh</p>\'" />';
            } else {
                box.innerHTML = '<div class="no-image"><i class="fas fa-image"></i></div><p>Nhập URL để xem trước ảnh</p>';
            }
        });
    </script>
}
