@model IEnumerable<PBL3_HealthCare.Models.Specialty>

@{
    ViewData["Title"] = "Quản lý Chuyên khoa";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/specialties.css" />
}

<div class="page-header">
    <div>
        <h4><i class="fas fa-stethoscope mr-2" style="color:#e74a3b;"></i>Quản lý Chuyên khoa</h4>
        <p>Danh sách các chuyên khoa trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-add">
        <i class="fas fa-plus"></i> Thêm chuyên khoa
    </a>
</div>

<div class="data-card card mb-4">
    <div class="card-body">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>Tên chuyên khoa</th>
                    <th>Mô tả</th>
                    <th class="text-center" style="width:130px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="specialty-icon-wrap">
                                    <i class="fas fa-stethoscope"></i>
                                </div>
                                <strong class="specialty-name">@Html.DisplayFor(m => item.Name)</strong>
                            </div>
                        </td>
                        <td><span class="desc-text">@Html.DisplayFor(m => item.Description)</span></td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit"><i class="fas fa-edit"></i> Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-detail"><i class="fas fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json" },
                "dom": '<"d-flex justify-content-between align-items-center mb-3"lf>rt<"d-flex justify-content-between align-items-center"ip>'
            });
        });
    </script>
}
