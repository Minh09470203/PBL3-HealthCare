@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
    // Gọi giao diện cắt vát chéo quen thuộc
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<style>
    /* CSS cho nút bấm Gradient cực mượt */
    .btn-auth-gradient {
        border-radius: 50px;
        padding: 14px 25px;
        font-weight: 700;
        font-size: 1rem;
        border: none;
        color: white;
        background: linear-gradient(to right, #00b5f1, #1ec8fe);
        box-shadow: 0 4px 10px rgba(0, 181, 241, 0.15);
        transition: all 0.3s ease;
        display: inline-block;
        text-align: center;
        text-decoration: none;
    }

        .btn-auth-gradient:hover {
            background: linear-gradient(to right, #00a2db, #00b5f1);
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(0, 181, 241, 0.2);
            color: white;
            text-decoration: none;
        }
</style>

<div class="d-flex flex-column justify-content-center align-items-center h-100 text-center" style="max-width: 450px; margin: 0 auto; width: 100%;">

    <div class="mb-4" style="width: 100px; height: 100px; background-color: rgba(0, 181, 241, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
        <i class="fas fa-check-circle" style="font-size: 4rem; color: #00b5f1;"></i>
    </div>

    <h2 class="fw-bold mb-3" style="color: #1a202c; letter-spacing: -0.5px; text-transform: uppercase;">Đổi mật khẩu thành công!</h2>

    <p class="text-muted mb-5" style="font-size: 1.05rem; line-height: 1.6;">
        Tài khoản của bạn đã được cập nhật mật khẩu mới an toàn.<br />
        Vui lòng sử dụng mật khẩu mới để đăng nhập vào hệ thống.
    </p>

    <a asp-page="./Login" class="w-100 btn btn-auth-gradient">
        ĐĂNG NHẬP NGAY
    </a>
</div>