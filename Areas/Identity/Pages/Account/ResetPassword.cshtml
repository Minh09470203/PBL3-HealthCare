@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<style>
    /* CSS NÂNG CẤP DÀNH RIÊNG CHO TRANG NÀY (Đồng bộ với Login) */
    .form-control-pill {
        border-radius: 50px;
        padding: 14px 25px;
        border: 1.5px solid #e2e8f0;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

        .form-control-pill:focus {
            border-color: #00b5f1;
            box-shadow: 0 0 0 4px rgba(0, 181, 241, 0.15);
            outline: none;
        }

    .btn-auth-gradient {
        border-radius: 50px;
        padding: 14px 25px;
        font-weight: 700;
        font-size: 1rem;
        border: none;
        color: white;
        background: linear-gradient(to right, #00b5f1, #1ec8fe);
        box-shadow: 0 4px 10px rgba(0, 181, 241, 0.15);
        transition: all 0.3s ease;
    }

        .btn-auth-gradient:hover {
            background: linear-gradient(to right, #00a2db, #00b5f1);
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(0, 181, 241, 0.2);
            color: white;
        }
</style>

<div class="d-flex flex-column justify-content-center h-100" style="max-width: 420px; margin: 0 auto; width: 100%;">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: #1a202c; letter-spacing: -1px; text-transform: uppercase;">TẠO MẬT KHẨU MỚI</h2>
        <p class="text-muted mt-2" style="font-size: 0.95rem;">
            Bước cuối cùng rồi! Vui lòng nhập lại email và thiết lập mật khẩu mới cho tài khoản của bạn.
        </p>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3 text-center" style="font-size: 0.9rem;" role="alert"></div>

        <input asp-for="Input.Code" type="hidden" />

        <div class="mb-4">
            <input asp-for="Input.Email" class="form-control form-control-pill" autocomplete="username" aria-required="true" placeholder="Nhập lại địa chỉ Email" />
            <span asp-validation-for="Input.Email" class="text-danger small ms-3 mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <input asp-for="Input.Password" type="password" class="form-control form-control-pill" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu mới" />
            <span asp-validation-for="Input.Password" class="text-danger small ms-3 mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-pill" autocomplete="new-password" aria-required="true" placeholder="Xác nhận lại mật khẩu mới" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small ms-3 mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn btn-auth-gradient w-100 mb-4">
            XÁC NHẬN ĐỔI MẬT KHẨU
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}